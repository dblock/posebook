# Local examples only; Rails does not load this file automatically.
MONGODB_URI=mongodb://127.0.0.1:27017/posebook_development
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/posebook_test
APP_HOST=localhost
# Supply a unique SECRET_KEY_BASE using your deployment platform's secret settings.
# Production email recovery needs SMTP_ADDRESS and MAIL_FROM.
# Optional: SMTP_PORT=587, SMTP_USERNAME, SMTP_PASSWORD.
# Optional Google Calendar OAuth; store the client secret in encrypted deployment settings.
# GOOGLE_CALENDAR_CLIENT_ID=your-web-client-id
# GOOGLE_CALENDAR_CLIENT_SECRET=your-web-client-secret
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/google_calendar/callback
