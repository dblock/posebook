<section class="location-activation" aria-label="<%= label %> access">
  <p><%= status_label(location.active? ? "Active" : "Inactive") %></p>
  <p>Deactivating hides this <%= label.downcase %> from public listings and blocks new bookings and date changes. Existing bookings, cancellations, and attendance confirmations remain available.</p>
  <%= button_to "#{location.active? ? "Deactivate" : "Activate"} #{label}", path, method: :patch,
                params: { active: !location.active? } %>
</section>
