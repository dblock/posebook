<span class="copy-control">
  <%= link_to url, url, class: "copy-visible-link" if local_assigns[:show_link] %>
  <%= button_tag local_assigns[:url] ? "Copy Link" : "Copy", type: "button", class: "copy-button",
                 data: { copy_target: local_assigns[:target], copy_link: local_assigns[:url] },
                 aria: { label: "Copy #{label}" }, hidden: true %>
  <% if local_assigns[:url] && !local_assigns[:show_link] %>
    <%= link_to url, url, class: "copy-fallback" %>
  <% end %>
  <span class="copy-feedback" role="status"></span>
</span>
