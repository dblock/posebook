<% content_for :head do %>
  <%= javascript_include_tag "profile-privacy", defer: true %>
<% end %>
<p><%= form.label :instagram_handle, "Instagram Handle" %><br><%= form.text_field :instagram_handle, placeholder: "@your_name", maxlength: 500, data: { instagram_handle: true } %></p>
<fieldset data-profile-privacy>
  <legend>Public Profile Preferences</legend>
  <p><%= form.label :display_name, "Display Name" %><br><%= form.text_field :display_name, maxlength: 100 %></p>
  <p><%= form.check_box :instagram_tagging_allowed, data: { instagram_tagging: true } %> <%= form.label :instagram_tagging_allowed, "Share my Instagram publicly and tag me" %></p>
  <p><small>Included in announcements and program calendars.</small></p>
</fieldset>
