<% content_for :head do %>
  <%= javascript_include_tag "profile-privacy", defer: true %>
<% end %>
<fieldset data-profile-privacy>
  <legend>Public Profile Preferences</legend>
  <p><%= form.check_box :public_profile_private, data: { profile_privacy_toggle: true } %> <%= form.label :public_profile_private, self_service ? "Keep all my information private" : "Keep this user's information private" %></p>
  <p><small>When private, public calendars at every program show "To be announced" instead of your name or Instagram. Organizers can still access your account and booking details. Saved sharing preferences apply again when you turn this off.</small></p>
  <%= tag.fieldset class: "public-sharing", disabled: @user.public_profile_private?, data: { public_profile_fields: true }, aria: { label: "Public sharing settings" } do %>
    <p><%= form.label :display_name, "Display name (public, optional)" %><br><%= form.text_field :display_name, maxlength: 100 %><br>
      <small>This will be public in announcements and program calendars. Leave blank to use your name, which will then be public instead.</small>
    </p>
    <p><%= form.label :instagram_handle, "Instagram handle (optional)" %><br><%= form.text_field :instagram_handle, placeholder: "@your_name", maxlength: 500 %><br>
      <small>Enter a handle or paste an Instagram profile URL; only the handle is saved. Shown publicly when tagging is enabled below.</small>
    </p>
    <p><%= form.check_box :instagram_tagging_allowed %> <%= form.label :instagram_tagging_allowed, "Tag Instagram in announcements and program calendars" %></p>
  <% end %>
</fieldset>
