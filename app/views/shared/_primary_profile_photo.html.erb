<section aria-label="Primary profile photo">
  <h2>Primary Profile Photo</h2>
  <p>Choose the photo shown beside this account's name in private tables. This does not change photo visibility. The first photo is used until you choose another.</p>
  <% if user.profile_photos.any? %>
    <div class="primary-photo-picker">
      <% user.profile_photos.each do |photo| %>
        <figure data-photo="<%= photo.id %>">
          <%= image_tag participant_photo_path(user, photo, thumbnail: 1), width: 120, height: 120,
                        loading: "lazy", alt: "Profile photo option" %>
          <% if user.primary_profile_photo.id == photo.id %>
            <figcaption class="photo-primary-control"><%= status_label("Primary") %></figcaption>
          <% else %>
            <div class="photo-primary-control">
              <%= button_to "Set Primary Photo", participant_photo_path(user, photo), method: :patch,
                            params: { profile_photo: { primary: "1" } }, class: "secondary-action" %>
            </div>
          <% end %>
        </figure>
      <% end %>
    </div>
  <% else %>
    <p>No photos yet. <%= link_to "Upload a photo", participant_path(user) %> to choose a primary photo.</p>
  <% end %>
</section>
