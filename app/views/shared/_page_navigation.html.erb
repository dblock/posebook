<% trail = [["Home", root_path], *breadcrumbs] %>
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <% trail.each_with_index do |(title, path), index| %>
    <% if index.positive? %><span aria-hidden="true">/</span><% end %>
    <% if index == trail.length - 1 %><span aria-current="page"><%= title %></span><% else %><%= link_to title, path %><% end %>
  <% end %>
  <% if breadcrumbs.one? %><span aria-hidden="true">&gt;</span><% end %>
</nav>
<% if current_user && (tabs.any? || local_assigns.fetch(:actions, []).any?) %>
  <%= render "shared/page_tabs", tabs: tabs, actions: local_assigns.fetch(:actions, []),
             active: active, tabs_class: tabs_class, label: label %>
  <% if local_assigns.fetch(:secondary_tabs, []).any? %>
    <%= render "shared/page_tabs", tabs: secondary_tabs, active: secondary_active,
               tabs_class: "#{tabs_class.sub('-tabs', '-secondary-tabs')} page-secondary-tabs", label: secondary_label %>
  <% end %>
<% end %>
