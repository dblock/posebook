<section class="location-card next-session" aria-labelledby="next-session-heading">
  <% if @next_session_date && (photo = @program.primary_photo) %>
    <figure class="location-card-photo" data-photo-series>
      <%= render "shared/photo_series", owner: @program, photo: photo, name: @program.name %>
    </figure>
  <% end %>
  <div class="location-card-summary">
    <h2 id="next-session-heading">Next <%= @program.program_label.titleize %></h2>
    <% if @next_session_date %>
      <p>
        <%= render "shared/date", value: @next_session_booking&.scheduled_start || @calendar.starts_at(@next_session_date), zone: @next_session_booking&.time_zone || @program.time_zone, show_time: false %><br>
        <%= @next_session_booking ? calendar_booking_time(@next_session_booking) : scheduled_calendar_time(@calendar, @next_session_date) %> (<%= @next_session_booking&.time_zone || @program.time_zone %>)
      </p>
      <% if @next_session_booking&.user&.active? %>
        <%= render "booked_participant", booking: @next_session_booking, manager: false,
                   fallback_name: "#{@program.participant_label} to be announced" %>
      <% else %>
        <p><%= @program.participant_label %> to be announced</p>
      <% end %>
    <% else %>
      <p>No scheduled <%= @program.program_label.pluralize.downcase %> within the booking window.</p>
    <% end %>
  </div>
</section>
