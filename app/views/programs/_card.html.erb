<article class="location-card program-card">
  <% photo = program.primary_photo || program.venue.primary_photo %>
  <%= link_to program_path(program), class: "location-card-photo" do %>
    <% if photo %>
      <% photo_url = photo.is_a?(ProgramPhoto) ? program_photo_path(program, photo, thumbnail: 1) : venue_photo_path(program.venue, photo, thumbnail: 1) %>
      <%= image_tag photo_url, width: 400, height: 400,
                    loading: "lazy", alt: "#{program.name} primary photo" %>
    <% else %>
      <%= image_tag "program-placeholder.svg", width: 400, height: 400,
                    loading: "lazy", alt: "No photo for #{program.name}" %>
    <% end %>
  <% end %>
  <div class="location-card-summary">
    <% unless program.booking_active? %><p><%= status_label("Inactive") %></p><% end %>
    <h2><%= link_to program.name, program_path(program) %></h2>
    <p><%= program_schedule_summary(program) %></p>
    <%= render "venues/location", venue: program.venue %>
    <% if local_assigns.fetch(:bookable, false) %>
      <%= link_to "Choose a Date", program_path(program, section: "calendar"), class: "button-link" %>
    <% elsif local_assigns.fetch(:managed, false) %>
      <%= link_to "Manage Calendar", program_path(program, section: "calendar"), class: "button-link" %>
    <% end %>
  </div>
</article>
