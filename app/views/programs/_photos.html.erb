<% photos = (editable ? program.photos : program.photos.visible).order_by(created_at: :asc).to_a %>
<%= render "shared/photo_gallery", photos: photos, editable: editable, upload_url: program_photos_path(program), scope: :program_photo,
           photo_url: ->(photo, **options) { program_photo_path(program, photo, **options) },
           description: ->(index) { "#{program.name} photo #{index + 1}" },
           primary_id: program.primary_photo(photos)&.id, empty_text: "No program photos yet.", figure_class: "program-photo" %>
