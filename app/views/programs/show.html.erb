<main>
  <%= render "navigation", program: @program, active: @section, detail: (@section.titleize unless @section == "view") %>
  <h1><%= @program.name %></h1>
  <% if @section == "view" %>
  <p><%= copyable(program_url(@program), label: "#{@program.program_label.downcase} link") { link_to "#{@program.program_label.titleize} Link", program_path(@program) } %></p>
  <p>Venue: <%= link_to @program.venue.name, venue_path(@program.venue) %></p>
  <%= simple_format(@program.address) %><%= copy_button(value: @program.address, label: "address") %>
  <% if @program.public_instagram_url %>
    <p><%= copyable("@#{@program.public_instagram_handle}", label: "Instagram handle") { link_to "@#{@program.public_instagram_handle}", @program.public_instagram_url, target: "_blank", rel: "noopener noreferrer" } %></p>
  <% end %>
  <dl>
    <dt>Time Zone</dt><dd><%= @program.time_zone %></dd>
    <dt>Regular Schedule</dt><dd><%= program_schedule_summary(@program) %></dd>
    <% if @program_member %>
      <dt>Pay</dt><dd><%= number_to_currency(@program.pay) %> USD</dd>
      <dt>Booking Horizon</dt><dd><%= @program.booking_horizon_months %> months</dd>
    <% end %>
  </dl>
  <% if @program_member %>
    <h2>Instructions</h2>
    <%= simple_format(@program.instructions) %>
  <% end %>
  <%= render "upcoming_booking" %>
  <% if @program_coordinator %><p><%= link_to "Edit #{@program.program_label.titleize}", edit_program_path(@program) %></p><% end %>
  <%= render "venues/photos", venue: @program.venue, editable: false %>
  <% elsif @section == "calendar" %>
  <%= render "upcoming_booking" %>
  <%= render "calendar", calendar: @calendar, public_view: !@program_member %>
  <% if @program_coordinator %>
    <p><%= link_to "Schedule #{@program.participant_article} #{@program.participant_label.titleize}", new_program_organizer_booking_path(@program) %> | <%= link_to "Manage Schedule", program_schedule_path(@program) %></p>
  <% end %>
  <% unless @program_member %>
    <p>Booking is available to invited <%= @program.participant_label.pluralize.downcase %>. <%= link_to "Sign In", program_path(@program, booking_invitation: "1") unless current_user %></p>
  <% end %>
  <% else %>
    <%= render "booking_history" %>
    <p>Changes and cancellations require an explanation and retain every booking record. Automated reminders are not available yet.</p>
  <% end %>
</main>
