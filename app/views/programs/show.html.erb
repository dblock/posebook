<main>
  <%= render "navigation", program: @program, active: @section, detail: (@section.titleize unless @section == "view") %>
  <% if @section == "view" %>
  <div class="title-row"><h1><%= @program.name %></h1><%= render "shared/copy_button", url: program_url(@program), label: "#{@program.name} link" %></div>
  <% else %>
  <h1><%= @program.name %></h1>
  <% end %>
  <% unless @program.booking_active? %><p role="status"><%= t('locations.inactive') %></p><% end %>
  <% if @section == "view" %>
  <%= render "next_session" %>
  <%= render "calendar", calendar: @calendar, public_view: !@program_member, show_schedule: false %>
  <% if @program_coordinator %>
    <p id="application-sharing"><strong>Application Link</strong> <%= status_label(@program.applications_enabled? && @program.booking_active? ? "Open" : "Closed") %><br>
      <%= render "shared/copy_button", url: program_apply_url(@program), label: "application link", show_link: true %>
    </p>
  <% end %>
  <% if @program_member %><%= render "venues/card", venue: @program.venue, show_photo: :available %><% end %>
  <% if @program_member %>
    <dl>
      <dt>Pay</dt><dd><%= number_to_currency(@program.pay) %> USD</dd>
      <dt>Booking Horizon</dt><dd><%= @program.booking_horizon_months %> months</dd>
    </dl>
  <% end %>
  <% if @program_member && @program.instructions.present? %>
    <h2>Instructions</h2>
    <%= render_markdown(@program.instructions) %>
  <% end %>
  <%= render "upcoming_booking" %>
  <%= render "application_action" %>
  <% elsif @section == "calendar" %>
  <%= render "upcoming_booking" %>
  <%= render "calendar", calendar: @calendar, public_view: !@program_member %>
  <% if @program_coordinator %>
    <p><% if @program.booking_active? %><%= link_to "Schedule #{@program.participant_article} #{@program.participant_label.titleize}", new_program_organizer_booking_path(@program) %> | <% end %><%= link_to "Manage Schedule", program_schedule_path(@program) %></p>
  <% end %>
  <% unless @program_member %>
    <p>Booking is available to invited <%= @program.participant_label.pluralize.downcase %>. <%= link_to "Sign In", program_path(@program, booking_invitation: "1") unless current_user %></p>
  <% end %>
  <% else %>
    <%= render "booking_history" %>
  <% end %>
</main>
