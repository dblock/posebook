<% if (participant = booking.user)&.active? %>
  <div class="booked-participant">
    <% if participant.public_photos.any? || (local_assigns[:manager] && participant.profile_photos.any?) %>
      <%= link_to booking_participant_name(participant, manager: local_assigns[:manager]), participant_path(participant) %>
    <% else %>
      <%= booking_participant_name(participant, manager: local_assigns[:manager]) %>
    <% end %>
    <% if (url = participant.public_instagram_url) %>
      <br><%= link_to "@#{participant.public_instagram_handle}", url, target: "_blank", rel: "noopener noreferrer" %>
    <% end %>
  </div>
<% end %>
