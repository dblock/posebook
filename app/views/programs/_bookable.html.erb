<% if programs.any? %>
  <section aria-labelledby="bookable-programs-heading">
    <h2 id="bookable-programs-heading"><%= local_assigns[:read_only] ? "Bookable Programs" : "Programs You Can Book" %></h2>
    <div class="location-cards bookable-programs">
      <% programs.each do |program| %><%= render "programs/card", program: program, bookable: !local_assigns[:read_only] %><% end %>
    </div>
  </section>
<% end %>
