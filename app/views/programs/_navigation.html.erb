<% manager = current_user && program.managed_by?(current_user) %>
<% tabs = [["view", "View", program_path(program)], ["calendar", "Calendar", program_path(program, section: "calendar")]] %>
<% tabs << ["history", "History", program_path(program, section: "history")] if manager %>
<% actions = [["photos", "Photos", photos_program_path(program)]] %>
<% if manager %>
  <% actions << ["participants", program.participant_label.pluralize.titleize, program_participants_path(program)] %>
  <% actions << ["invitations", "#{program.participant_label.titleize} Invitations", program_participant_invitations_path(program)] %>
  <% actions << ["applications", "Applications", program_applications_path(program)] %>
  <% actions << ["edit", "Edit", edit_program_path(program)] %>
<% end %>
<% actions << ["coordinators", "Coordinators", program_coordinators_path(program)] if program.venue.coordinated_by?(current_user) %>
<% actions << ["google_calendar", "Google Calendar", program_google_calendar_path(program)] if manager %>
<% breadcrumbs = [["Venues", venues_path], [program.venue.name, venue_path(program.venue)], [program.name, program_path(program)]] %>
<% section = (tabs + actions).find { |key, _, _| key == active } %>
<% breadcrumbs << [section[1], section[2]] if section && active != "view" %>
<% breadcrumbs << [detail, nil] if local_assigns[:detail].present? && detail != section&.fetch(1) %>
<%= render "shared/page_navigation", breadcrumbs: breadcrumbs, tabs: tabs, actions: actions, active: active, tabs_class: "program-tabs", label: "#{program.program_label.titleize} navigation" %>
