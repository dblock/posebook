<% if calendar_day_empty?(calendar, date) %>
  <td data-date="<%= date.iso8601 %>"></td>
<% else %>
  <% reason = calendar_day_reason(calendar, date, public_view: public_view, manager: @program_coordinator) %>
  <% booking = calendar.displayed_bookings[date] unless reason == "Future" %>
  <% reason ||= booking.user_id == current_user&.id ? "Your booking" : "Already booked" if booking %>
  <% reason ||= "You are already scheduled" if @my_booking && !@changing_booking %>
  <% reason ||= @booking_access.paused? ? "Booking paused" : "Invitation required" if @booking_access&.participant? && !@can_book %>
  <% reason ||= calendar.gender_blocked_reason(date, current_user, excluding: @changing_booking&.id) if !public_view && @can_book %>
  <% label = calendar_day_label(booking, reason) %>
  <% no_session = !booking && reason == "No #{calendar.program.program_label.titleize}" %>
  <td data-date="<%= date.iso8601 %>" class="<%= calendar_day_class(booking, reason) %>">
    <time datetime="<%= date.iso8601 %>"><% if no_session && @program_coordinator && date.between?(calendar.today, calendar.last_date) %><%= link_to date.day, program_schedule_path(calendar.program, date: date.iso8601), aria: { label: "Edit #{date.iso8601}" } %><% else %><%= date.day %><% end %></time>
    <% if reason != "Future" && (clock = calendar_time(calendar, date)) %><strong><%= clock %></strong><br><% end %>
    <% if booking %>
      <% hide_booked = !public_view && booking.user_id == current_user&.id && booking.display_status == "Booked" %>
      <%= render "programs/booking_status", booking: booking, private_view: !public_view && (@program_coordinator || booking.user_id == current_user&.id), show_status: !hide_booked %>
    <% elsif !no_session %>
      <%= status_label(label) %>
    <% end %>
    <%= render "programs/booked_participant", booking: booking, manager: @program_coordinator if booking %>
    <% if booking && @program_coordinator && booking.ends_at > Time.current %><%= link_to "Edit Booking", edit_program_organizer_booking_path(calendar.program, booking) %><% end %>
    <% if reason && reason != label && !no_session && !(public_view && booking) %><small><%= reason %></small><% end %>
    <% if reason != "Future" && !public_view && calendar.schedule.exceptions[date]&.mode == "open" %><small><%= calendar.schedule.exceptions[date].reason %></small><% end %>
    <% if !reason && @changing_booking %>
      <%= button_tag "Choose", type: "submit", form: "booking-change-form", name: "date", value: date.iso8601, aria: { label: "Choose #{date.iso8601}" } %>
    <% elsif !reason && @can_book %>
      <%= button_to "Book", program_bookings_path(calendar.program), params: { date: date.iso8601 }, aria: { label: "Book #{date.iso8601}" } %>
    <% end %>
    <% if @program_coordinator && !booking && calendar.blocked_reason(date).nil? %>
      <%= link_to "Schedule #{@program.participant_label.titleize}", new_program_organizer_booking_path(calendar.program, date: date.iso8601), aria: { label: "Schedule #{@program.participant_label.downcase} #{date.iso8601}" } %>
    <% end %>
    <% if @program_coordinator && !no_session && date.between?(calendar.today, calendar.last_date) %>
      <%= link_to "Edit Day", program_schedule_path(calendar.program, date: date.iso8601), aria: { label: "Edit #{date.iso8601}" } %>
    <% end %>
  </td>
<% end %>
