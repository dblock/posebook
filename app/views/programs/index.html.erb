<main>
  <%= render "shared/directory_navigation", active: "programs" %>
  <h1>Programs</h1>
  <% if @programs.empty? %>
    <p>No programs assigned. Visit Venues to create a program or contact a coordinator for access.</p>
  <% else %>
    <div class="location-cards">
      <% @programs.each do |program| %><%= render "card", program: program %><% end %>
    </div>
  <% end %>
</main>
