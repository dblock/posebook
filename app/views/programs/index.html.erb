<main>
  <%= render "shared/directory_navigation", active: "programs" %>
  <h1>Programs</h1>
  <% if @programs.empty? %>
    <p>No programs assigned. Visit Venues to create a program or contact a coordinator for access.</p>
  <% else %>
    <ul>
      <% @programs.each do |program| %>
        <li><%= link_to program.name, program %> - <%= program_schedule_summary(program) %></li>
      <% end %>
    </ul>
  <% end %>
</main>
