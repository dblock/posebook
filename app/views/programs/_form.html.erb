<%= render "shared/errors", record: program %>
<%= form_with model: program.persisted? ? program : [program.venue, program] do |form| %>
  <p><%= form.label :name %><br><%= form.text_field :name, required: true, maxlength: 100 %></p>
  <p><%= form.label :program_label, "Program Label" %><br><%= form.text_field :program_label, required: true, maxlength: 40 %><br><small>Such as Program or Workshop.</small></p>
  <p><%= form.label :participant_label, "Participant Label" %><br><%= form.text_field :participant_label, required: true, maxlength: 40 %><br><small>Such as Participant or Instructor.</small></p>
  <p><%= form.label :custom_slug, "Shortcut" %><br><%= form.text_field :custom_slug, maxlength: 100, placeholder: program.name.to_s.to_url %><br>
    <small>Blank generates one. Old links keep working.<% if program.persisted? %> <%= link_to program_url(program), program_path(program) %><% end %></small>
  </p>
  <p>Venue: <%= link_to program.venue.name, venue_path(program.venue) %></p>
  <p><%= form.label :time_zone, "Time Zone" %><br><%= form.select :time_zone, Program::TIME_ZONES, {}, required: true %></p>
  <p><%= form.label :start_time, "Regular Start Time" %><br><%= form.time_field :start_time, required: true, step: 60 %><br>
    <small>Change single dates in Manage Schedule.</small>
  </p>
  <p><%= form.label :end_time, "Regular End Time (optional)" %><br><%= form.time_field :end_time, step: 60 %><br>
    <small>Before the start time means the next day.</small>
  </p>
  <p><%= form.label :calendar_invitation_lead_minutes, "Calendar Invitation Lead Time (minutes)" %><br>
    <%= form.number_field :calendar_invitation_lead_minutes, min: 0, step: 1, required: true %><br>
    <small>Minutes before the start that calendar invitations begin.</small>
  </p>
  <p><%= form.label :pay, "Pay (USD)" %><br><%= form.number_field :pay, min: 0, step: "0.01", required: true %></p>
  <p><%= form.label :first_bookable_date, "First Bookable Date (optional)" %><br><%= form.date_field :first_bookable_date %><br>
    <small>Blank means today.</small>
  </p>
  <p><%= form.label :booking_horizon_months, "Booking Horizon (months)" %><br><%= form.number_field :booking_horizon_months, min: 1, required: true %><br>
    <small>Months ahead that can be booked.</small>
  </p>
  <fieldset>
    <legend>Available Weekdays</legend>
    <%= hidden_field_tag "program[available_weekdays][]", "" %>
    <% Date::DAYNAMES.each_with_index do |day, index| %>
      <label><%= check_box_tag "program[available_weekdays][]", index, program.available_weekdays.include?(index.to_s), id: "weekday-#{index}" %> <%= day %></label>
    <% end %>
  </fieldset>
  <fieldset>
    <legend>Prevent Consecutive <%= @program.participant_label.pluralize.titleize %> by Gender</legend>
    <p><small>Selected genders can't book back-to-back dates. Organizers can override.</small></p>
    <%= hidden_field_tag "program[no_consecutive_genders][]", "" %>
    <% User::GENDERS.each do |gender| %>
      <label><%= check_box_tag "program[no_consecutive_genders][]", gender, program.no_consecutive_genders.include?(gender), id: "no-consecutive-#{gender}" %> <%= gender.capitalize %></label>
    <% end %>
  </fieldset>
  <p><%= form.label :instructions %><br><%= form.text_area :instructions, maxlength: 5000, rows: 4 %><br>
    <small>Private to participants and coordinators. Supports Markdown: headings, lists, **bold**, *italic*, and [links](https://example.com).</small>
  </p>
  <p><label><%= form.check_box :applications_enabled %> Accept Participation Applications</label><br>
    <small>Requires email and an active coordinator.</small>
    <% if program.persisted? %>
      <br><small>Application link: <%= link_to program_apply_url(program), program_apply_path(program) %></small>
    <% end %>
  </p>
  <%= form.submit program.persisted? ? "Save #{@program.program_label.titleize}" : "Create #{@program.program_label.titleize}" %>
<% end %>
