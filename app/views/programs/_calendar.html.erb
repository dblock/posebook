<% content_for :head do %>
  <%= javascript_include_tag "calendar", defer: true %>
<% end %>
<% public_view = local_assigns.fetch(:public_view, true) %>
<section aria-label="<%= calendar.program.program_label.downcase %> calendar" data-calendar data-calendar-context="<%= calendar_access_context(public_view, manager: @program_coordinator, program: calendar.program, booking: @my_booking) %>">
  <h2><%= calendar.program.program_label.titleize %> Calendar</h2>
  <%= render "programs/regular_schedule", program: calendar.program %>
  <% if calendar.first_date > calendar.today %>
    <p class="booking-window-notice">Invited participants can book now for dates on or after <strong><%= calendar.first_date.strftime("%B %-d, %Y") %></strong>. Earlier sessions remain managed by the organizer.</p>
  <% end %>
  <nav aria-label="Calendar months">
    <% if calendar.month > calendar.today.beginning_of_month %>
      <%= link_to "Previous Month", calendar_month_path(calendar, calendar.month - 1.month, @changing_booking), data: { calendar_navigation: true } %>
    <% end %>
    <strong data-calendar-month tabindex="-1"><%= calendar.month.strftime("%B %Y") %></strong>
    <% if calendar.month < calendar.last_date.beginning_of_month %>
      <%= link_to "Next Month", calendar_month_path(calendar, calendar.month + 1.month, @changing_booking), data: { calendar_navigation: true } %>
    <% end %>
  </nav>
  <p>Dates and times use <%= calendar.program.time_zone %>.</p>
  <p class="scroll-hint">Scroll horizontally to view all days.</p>
  <div class="table-scroll" role="region" aria-label="Calendar dates" tabindex="0">
    <table class="calendar">
      <thead><tr><% Date::ABBR_DAYNAMES.each do |day| %><th scope="col"><%= day %></th><% end %></tr></thead>
      <tbody>
        <% calendar.weeks.each do |week| %>
          <tr>
            <% week.each do |date| %>
              <%= render "programs/calendar_day", calendar: calendar, date: date, public_view: public_view %>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
