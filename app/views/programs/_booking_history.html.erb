<section>
  <h2><%= @program_coordinator ? "#{@program.program_label.titleize} Booking History" : "Your Booking History" %></h2>
  <% if @booking_history.any? %>
    <p class="scroll-hint">Scroll horizontally to view the full history.</p>
    <div class="table-scroll" role="region" aria-label="Booking history" tabindex="0">
      <table>
        <thead><tr><th>Date / Time</th><% if @program_coordinator %><th><%= @program.participant_label.titleize %></th><% end %><th>Status</th><th>Explanation</th></tr></thead>
        <tbody>
          <% @booking_history.each do |booking| %>
            <tr>
              <td><%= booking.date.iso8601 %><br><%= booking_time(booking) %><% if booking.previous_booking %><br>Moved from <%= booking.previous_booking.date.iso8601 %><% end %></td>
              <% if @program_coordinator %><td><%= booking_participant_name(booking.user, manager: true) %></td><% end %>
              <td>
                <%= render "programs/booking_status", booking: booking, private_view: true %>
                <% if @program_coordinator && booking.status == "confirmed" && booking.ends_at > Time.current %><%= link_to "Edit Booking", edit_program_organizer_booking_path(@program, booking) %><% end %>
              </td>
              <td>
                <%= booking.reason.presence || "-" %>
                <% if @program_coordinator && booking.gender_override_reason.present? %>
                  <p>Gender-rule override: <%= booking.gender_override_reason %></p>
                <% end %>
                <% booking.time_changes.each do |change| %>
                  <% if change["from"] != change["to"] || !change.key?("from_end") %>
                    <p><%= change["from"].in_time_zone(booking.time_zone).strftime("%-I:%M %p %Z") %> to <%= change["to"].in_time_zone(booking.time_zone).strftime("%-I:%M %p %Z") %>: <%= change["reason"] %></p>
                  <% end %>
                  <% if change.key?("from_end") && change["from_end"] != change["to_end"] %>
                    <p>End time: <%= change["from_end"] ? change["from_end"].in_time_zone(booking.time_zone).to_fs(:long) : "not set" %> to <%= change["to_end"] ? change["to_end"].in_time_zone(booking.time_zone).to_fs(:long) : "not set" %>: <%= change["reason"] %></p>
                  <% end %>
                <% end %>
                <% booking.attendance_changes.each do |change| %>
                  <p><%= change["confirmed"] ? "Confirmed" : "Attendance confirmation cleared" %> on <%= change["changed_at"].in_time_zone(booking.time_zone).to_fs(:long) %>: <%= change["reason"] %></p>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p>No bookings yet.</p>
  <% end %>
</section>
