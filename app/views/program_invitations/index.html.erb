<main data-application-region>
  <%= render "programs/navigation", program: @program, active: "invitations" %>
  <h1>Invitations</h1>
  <%= render "shared/table_filter", url: program_participant_invitations_path(@program), name: :status, label: "Status",
             selected: @status, options: [["All", "all"], ["Pending", "pending"], ["Accepted", "accepted"], ["Revoked", "revoked"], ["Expired", "expired"]] %>
  <% if @invitations.empty? %>
    <p>No invitations<%= " on this page" if @pagination.cursor %>.</p>
  <% else %>
    <p class="scroll-hint">Scroll horizontally to view invitation dates and actions.</p>
    <div class="table-scroll" role="region" aria-label="<%= @program.participant_label.titleize %> invitations" tabindex="0">
      <table class="participant-invitations">
        <thead><tr><th>Invitee</th><th>Status</th><th>Invited</th><th>Invited By</th><th>Expires</th><th>Accepted</th><th>Revoke</th><th>View</th></tr></thead>
        <tbody>
          <% @invitations.each do |invitation| %>
            <tr data-invitation="<%= invitation.id %>">
              <td class="invitation-recipient">
                <% invitee = @invitees[invitation.used_by_id] %>
                <%= render "shared/participant_identity", participant: invitation, profile: invitee,
                           path: invitee ? participant_path(invitee) : program_participant_invitation_path(@program, invitation),
                           show_instagram: false %>
              </td>
              <td class="invitation-status"><%= status_label(invitation.status) %></td>
              <td><%= render "shared/date", value: invitation.created_at, zone: @program.time_zone, format: :compact %></td>
              <td class="invitation-sender"><% if (sender = invitation.invited_by)&.name.present? %><%= link_to sender.name, participant_path(sender) %><% else %>Not recorded<% end %></td>
              <td><%= render "shared/date", value: invitation.expires_at, zone: @program.time_zone, format: :compact %></td>
              <td><% if invitation.used_at %><%= render "shared/date", value: invitation.used_at, zone: @program.time_zone, format: :compact %><% else %>Not accepted<% end %></td>
              <td><% if invitation.status == "Pending" %>
                <%= button_to "Revoke", program_participant_invitation_path(@program, invitation, cursor: @pagination.cursor, status: params[:status]), method: :delete, class: "secondary-action", aria: { label: "Revoke invitation for #{invitation.name.presence || invitation.email.presence || 'participant'}" } %>
              <% end %></td>
              <td><%= link_to "View", program_participant_invitation_path(@program, invitation, cursor: @pagination.cursor, status: params[:status]), aria: { label: "View invitation for #{invitation.name.presence || invitation.email.presence || 'participant'}" } %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  <%= render "shared/pagination", pagination: @pagination, label: "Invitation pages" %>
  <p><%= link_to "Invite #{@program.participant_article} #{@program.participant_label.titleize}", new_program_participant_invitation_path(@program), class: "button-link" %></p>
</main>
