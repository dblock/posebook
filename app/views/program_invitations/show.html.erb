<main>
  <%= render "programs/navigation", program: @program, active: "invitations", detail: "#{@program.participant_label.titleize} Invitation" %>
  <h1><%= @program.participant_label.titleize %> Invitation</h1>
  <p><%= @program.name %> - <%= status_label(@invitation.status) %></p>
  <p class="invitation-recipient"><%= participant_contact_label(@invitation) %></p>
  <p><strong>Submitted On:</strong> <%= render "shared/date", value: @invitation.created_at, zone: @program.time_zone %></p>
  <%= render "programs/regular_schedule", program: @program %>
  <% if @token.present? %>
    <p><%= label_tag :invitation_link, "Invitation Link (copy now)" %><span class="copy-field"><%= url_field_tag :invitation_link, invitation_url(token: @token, **Rails.configuration.action_mailer.default_url_options), readonly: true %><%= copy_button(target: "invitation_link", label: "private invitation link") %></span></p>
    <p>This link is shown only once. Share it privately with one <%= @program.participant_label.downcase %>; they can create an account or sign in with an existing one.<% if @invitation.email.present? %> Only <%= @invitation.email %> can accept it.<% end %></p>
  <% end %>
  <% if @invitation.status == "Pending" %>
    <%= button_to "Revoke", program_participant_invitation_path(@program, @invitation, cursor: params[:cursor], status: params[:status]), method: :delete, class: "secondary-action" %>
  <% end %>
  <p><%= link_to "Back to Invitations", program_participant_invitations_path(@program, cursor: params[:cursor], status: params[:status]) %></p>
</main>
