<main>
  <h1><%= @program.participant_label.titleize %> Invitation</h1>
  <p><%= @program.name %> - <%= status_label(@invitation.status) %></p>
  <%= render "programs/regular_schedule", program: @program %>
  <% if @token.present? %>
    <p><%= label_tag :invitation_link, "Invitation link (copy now)" %><br><%= url_field_tag :invitation_link, invitation_url(token: @token, **Rails.configuration.action_mailer.default_url_options), readonly: true %></p>
    <p>This link is shown only once. Share it privately with one <%= @program.participant_label.downcase %>; they can create an account or sign in with an existing one.</p>
  <% else %>
    <p>The private link is only displayed when the invitation is created. Create a new invitation if you did not keep it.</p>
  <% end %>
  <p><%= link_to "Back to #{@program.program_label.titleize}", program_path(@program) %></p>
</main>
