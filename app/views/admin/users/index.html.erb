<main>
  <%= javascript_include_tag "user-access", defer: true %>
  <%= render "admin/navigation", active: "users" %>
  <h1>Users</h1>
  <p class="scroll-hint">Scroll horizontally to view account details and controls.</p>
  <div class="table-scroll" role="region" aria-label="User accounts" tabindex="0">
    <table class="user-accounts">
      <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Global Roles</th><th>Status</th><th>Access</th><th>Details</th></tr></thead>
      <tbody>
        <% @users.each do |user| %>
          <tr id="<%= dom_id(user) %>">
            <% current = user == current_user %>
            <td><%= render "shared/participant_identity", participant: user, show_email: false, path: admin_user_path(user), you: current %></td>
            <td><%= link_to user.email, admin_user_path(user) %></td><td><%= user.display_phone.presence || "Not provided" %></td>
            <td><%= safe_join(user.roles.map { |role| status_label(role.tr("_", " ")) }, " ") %></td>
            <td><%= status_label(user.active? ? "Active" : "Inactive") %></td>
            <td data-user-access>
              <% if !user.active? %>
                <%= button_to "Reactivate", admin_user_path(user), method: :patch, params: { active: true }, class: "secondary-action" %>
              <% elsif !user.system_admin? %>
                <%= button_to "Deactivate", admin_user_path(user), method: :patch, params: { active: false }, class: "secondary-action" %>
              <% else %>
                <%= status_label("Protected") %>
              <% end %>
            </td>
            <td><%= link_to "Edit", edit_admin_user_path(user) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</main>
