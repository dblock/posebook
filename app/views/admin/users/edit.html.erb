<main>
  <h1>Edit User</h1>
  <%= render "shared/errors", record: @user %>
  <p>Email changes apply immediately, sign the user out of all sessions, and cancel outstanding recovery and email-change links. The new address is not marked verified. Changing your own email requires signing in again.</p>
  <% if @user.pending_email.present? %>
    <p>Verification pending for <%= @user.pending_email %>. Saving a different email cancels this request.</p>
  <% end %>
  <%= form_with model: @user, url: admin_user_path(@user), method: :patch do |form| %>
    <p><%= form.label :name %><br><%= form.text_field :name, required: true, autocomplete: "name", maxlength: 100 %></p>
    <p><%= form.label :email %><br><%= form.email_field :email, required: true, autocomplete: "email" %></p>
    <p><%= form.label :phone %><br><%= form.telephone_field :phone, autocomplete: "tel" %><br>Use an international number beginning with +. Phone numbers are unverified.</p>
    <%= render "shared/public_profile_fields", form: form, self_service: false %>
    <%= form.submit "Save User" %>
  <% end %>
  <p><%= link_to "Cancel", admin_users_path %></p>
</main>
