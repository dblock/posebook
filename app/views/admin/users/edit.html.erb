<main data-edit-in-place>
  <%= render "profiles/navigation", user: @user, active: "edit" %>
  <h1>Edit User</h1>
  <%= render "shared/errors", record: @user %>
  <p>Email changes apply immediately, sign the user out of all sessions, and cancel outstanding recovery and email-change links.</p>
  <% if @user.pending_email.present? %>
    <p>Verification pending for <%= @user.pending_email %>. Saving a different email cancels this request.</p>
  <% end %>
  <%= form_with model: @user, url: admin_user_path(@user), method: :patch do |form| %>
    <p><%= form.label :name %><br><%= form.text_field :name, required: true, autocomplete: "name", maxlength: 100 %></p>
    <p><%= form.label :email %><br><%= form.email_field :email, required: true, autocomplete: "email" %></p>
    <p><%= form.label :phone %><br><%= form.telephone_field :phone, value: form.object.display_phone, required: true, autocomplete: "tel", placeholder: "+1 (212) 555-1234" %></p>
    <%= render "shared/gender_field", form: form %>
    <%= render "shared/public_profile_fields", form: form %>
    <%= form.submit "Save User" %>
  <% end %>
  <p><%= link_to "Cancel", admin_users_path %></p>
</main>
