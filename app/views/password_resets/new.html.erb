<main>
  <h1>Reset Your Password</h1>
  <%= form_with url: password_resets_path do |form| %>
    <p><%= form.label :email %><br><%= form.email_field :email, required: true, autocomplete: "email" %></p>
    <%= form.submit "Send Reset Link" %>
  <% end %>
  <p><%= link_to "Back to sign in", new_session_path %></p>
</main>
