<main>
  <h1>Choose a New Password</h1>
  <%= render "shared/errors", record: @user %>
  <%= form_with url: password_reset_path(params[:token]), scope: :user, method: :patch do |form| %>
    <p><%= form.label :password %> (at least 12 characters)<br><%= form.password_field :password, required: true, minlength: 12, autocomplete: "new-password" %></p>
    <p><%= form.label :password_confirmation %><br><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %></p>
    <%= form.submit "Update Password" %>
  <% end %>
</main>
