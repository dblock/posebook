<main>
  <h1>Sessions</h1>
  <p><%= link_to "Venues", venues_path %></p>
  <% if @drawing_sessions.empty? %>
    <p>No sessions assigned. Visit Venues to create a session or contact a coordinator for access.</p>
  <% else %>
    <ul>
      <% @drawing_sessions.each do |drawing_session| %>
        <li><%= link_to drawing_session.name, drawing_session %> - <%= drawing_session_schedule_summary(drawing_session) %></li>
      <% end %>
    </ul>
  <% end %>
</main>
