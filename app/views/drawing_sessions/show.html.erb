<main>
  <h1><%= @drawing_session.name %></h1>
  <p>Venue: <%= link_to @drawing_session.venue.name, venue_path(@drawing_session.venue) %></p>
  <%= simple_format(@drawing_session.address) %>
  <% if @drawing_session.public_instagram_url %>
    <p><%= link_to "@#{@drawing_session.public_instagram_handle}", @drawing_session.public_instagram_url, target: "_blank", rel: "noopener noreferrer" %></p>
  <% end %>
  <dl>
    <dt>Time Zone</dt><dd><%= @drawing_session.time_zone %></dd>
    <dt>Regular Schedule</dt><dd><%= drawing_session_schedule_summary(@drawing_session) %></dd>
    <% if @drawing_session_member %>
      <dt>Model Pay</dt><dd><%= number_to_currency(@drawing_session.model_pay) %> USD</dd>
      <dt>Booking Horizon</dt><dd><%= @drawing_session.booking_horizon_months %> months</dd>
    <% end %>
  </dl>
  <% if @drawing_session_member %>
    <h2>Instructions</h2>
    <%= simple_format(@drawing_session.instructions) %>
  <% end %>
  <% if @booking_access&.model? && !@can_book %><p role="status"><%= @booking_access.reason %></p><% end %>
  <% if @my_booking %>
    <h2>Your Upcoming Booking</h2>
    <p><%= @my_booking.date.to_fs(:long) %> at <%= booking_time(@my_booking) %>. You can have one upcoming booking at this session.</p>
    <%= render "model_bookings/attendance", drawing_session: @drawing_session, booking: @my_booking %>
    <% if @my_booking.rescheduling_locked? %><%= render "model_bookings/rescheduling_notice", drawing_session: @drawing_session, urgent: @my_booking.attendance_overdue? %><% end %>
    <p><% if @can_book && !@my_booking.confirmation_open? && !@my_booking.rescheduling_locked? %><%= link_to "Change Date", edit_drawing_session_model_booking_path(@drawing_session, @my_booking) %> | <% end %><%= link_to "Cancel Booking", cancellation_drawing_session_model_booking_path(@drawing_session, @my_booking) %></p>
  <% end %>
  <%= render "calendar", calendar: @calendar, public_view: !@drawing_session_member %>
  <% if @drawing_session_member %>
    <%= render "booking_history" %>
    <p>Changes and cancellations require an explanation and retain every booking record. Automated reminders are not available yet.</p>
  <% else %>
    <p>Booking is available to invited models. <%= link_to "Sign In", drawing_session_path(@drawing_session, booking_invitation: "1") unless current_user %></p>
  <% end %>
  <%= render "invitations" if @session_coordinator %>
  <% if @session_coordinator %>
    <p><%= link_to "Schedule a Model", new_drawing_session_organizer_booking_path(@drawing_session) %> | <%= link_to "Manage Schedule", drawing_session_schedule_path(@drawing_session) %> | <%= link_to "Models", drawing_session_models_path(@drawing_session) %></p>
  <% end %>

  <% if @session_coordinator %><p><%= link_to "Edit Session", edit_drawing_session_path(@drawing_session) %></p><% end %>
  <% if @drawing_session.venue.coordinated_by?(current_user) %><p><%= link_to "Session Coordinators", drawing_session_coordinators_path(@drawing_session) %></p><% end %>
  <%= render "venues/photos", venue: @drawing_session.venue, editable: false %>
</main>
