<%= booking.reason %>
<% booking.time_changes.each do |change| %>
  <% if change["from"] != change["to"] || !change.key?("from_end") %>
    <p><%= render "shared/date", value: change["from"], zone: booking.time_zone, format: :compact %> to <%= render "shared/date", value: change["to"], zone: booking.time_zone, format: :compact %>: <%= change["reason"] %></p>
  <% end %>
  <% if change.key?("from_end") && change["from_end"] != change["to_end"] %>
    <p>End time: <% if change["from_end"] %><%= render "shared/date", value: change["from_end"], zone: booking.time_zone, format: :compact %><% else %>not set<% end %> to <% if change["to_end"] %><%= render "shared/date", value: change["to_end"], zone: booking.time_zone, format: :compact %><% else %>not set<% end %>: <%= change["reason"] %></p>
  <% end %>
<% end %>
<% booking.attendance_changes.each do |change| %>
  <p><%= change["confirmed"] ? "Confirmed" : "Attendance confirmation cleared" %> on <%= render "shared/date", value: change["changed_at"], zone: booking.time_zone, format: :compact %>: <%= change["reason"] %></p>
<% end %>
