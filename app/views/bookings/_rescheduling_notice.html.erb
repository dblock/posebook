<% cancellation = local_assigns.fetch(:cancellation, false) %>
<% title = cancellation ? "Contact an Organizer" : "Contact an Organizer Before Rescheduling" %>
<% title = "Attendance Confirmation Needed" if local_assigns[:urgent] %>
<aside class="rescheduling-notice" aria-label="<%= title %>">
  <h3><%= title %></h3>
  <% if local_assigns[:urgent] %>
    <p>Your <%= program.program_label.downcase %> is within five days. Please confirm that you will be there, or contact an organizer if you cannot make it so we can find a replacement.</p>
  <% else %>
    <p>Your <%= program.program_label.downcase %> is within five days. If you cannot make it, contact an organizer so we can find a replacement.</p>
  <% end %>
  <% organizers = program_organizer_contacts(program) %>
  <% if organizers.any? %>
    <ul>
      <% organizers.each do |organizer| %>
        <li><strong><%= organizer.name %></strong>: <%= mail_to organizer.email %><% if organizer.phone.present? %> &middot; <%= link_to organizer.display_phone, "tel:#{organizer.phone}" %><% end %></li>
      <% end %>
    </ul>
  <% else %>
    <p>No organizer contact details are listed. Please contact the <%= program.program_label.downcase %> directly.</p>
  <% end %>
</aside>
