<div class="booking-attendance" aria-label="Attendance confirmation">
  <%= render "programs/booking_status", program: program, booking: booking, private_view: true, show_warning: false,
             show_status: local_assigns.fetch(:show_status, true) %>
  <% if booking.attendance_confirmed? %>
    <p>You're confirmed. See you there!</p>
  <% elsif confirmation_open && !booking.rescheduling_locked? %>
    <p>Please confirm that you will be there for your <%= program.program_label.downcase %>.</p>
  <% end %>
</div>
