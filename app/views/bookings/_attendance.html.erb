<section class="attendance-panel" aria-label="Attendance confirmation">
  <%= render "programs/booking_status", booking: booking, private_view: true %>
  <% if booking.attendance_confirmed? %>
    <p>You're confirmed. See you there! Contact an organizer if your plans change.</p>
  <% elsif booking.confirmation_open? %>
    <%= button_to "I'll be there!", confirm_program_booking_path(program, booking), params: { booking_version: booking.lock_version } %>
    <p>Please confirm that you will be there for your <%= @program.program_label.downcase %>.</p>
  <% elsif Time.current < booking.scheduled_start %>
    <p>Confirmation opens on <%= booking.confirmation_opens_on.to_fs(:long) %> in <%= booking.time_zone %>, seven calendar days before your <%= @program.program_label.downcase %>.</p>
  <% end %>
  <% if @can_book && booking.confirmation_open? && !booking.rescheduling_locked? %>
    <p><%= link_to "I can no longer make it.", edit_program_booking_path(program, booking) %></p>
  <% end %>
</section>
