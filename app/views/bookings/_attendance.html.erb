<div class="booking-attendance" aria-label="Attendance confirmation">
  <%= render "programs/booking_status", program: program, booking: booking, private_view: true %>
  <% if booking.attendance_confirmed? %>
    <p>You're confirmed. See you there!</p>
  <% elsif booking.confirmation_open? %>
    <%= button_to "I'll be there!", confirm_program_booking_path(program, booking), params: { booking_version: booking.lock_version } %>
    <p>Please confirm that you will be there for your <%= program.program_label.downcase %>.</p>
  <% end %>
</div>
