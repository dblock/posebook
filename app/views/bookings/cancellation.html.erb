<main>
  <%= render "programs/navigation", program: @program, active: "calendar", detail: "Cancel Booking" %>
  <h1>Cancel Your Booking</h1>
  <%= render "programs/regular_schedule", program: @program %>
  <p><%= render "shared/date", value: @booking.scheduled_start, zone: @booking.time_zone, show_time: false %> at <%= booking_time(@booking) %>, <%= @program.name %>. Your booking and explanation will remain in the history.</p>
  <% if @booking.rescheduling_locked? %><%= render "bookings/rescheduling_notice", program: @program, cancellation: true %><% end %>
  <%= form_with url: cancel_program_booking_path(@program, @booking) do %>
    <%= hidden_field_tag :booking_version, request.get? ? @booking.lock_version : params[:booking_version] %>
    <p><%= label_tag :reason, "Explanation" %><br><%= text_area_tag :reason, params[:reason], required: true, maxlength: 2000, rows: 3 %></p>
    <%= submit_tag "Cancel Booking" %>
  <% end %>
  <p><%= link_to "Keep My Booking", calendar_program_path(@program) %></p>
</main>
