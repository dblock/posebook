<main>
  <% if @target.is_a?(Program) %><%= render "programs/navigation", program: @target, active: "invite_coordinator", detail: "Coordinator Invitation" %><% end %>
  <% if @target.is_a?(Venue) %><%= render "venues/navigation", venue: @target, active: "invite_coordinator", detail: "Coordinator Invitation" %><% end %>
  <h1><%= @invitation.coordinator_label %> Invitation to <%= @invitation.target.name %></h1>
  <p><% if @invitation.email.present? %>Invited email: <%= @invitation.email %>.<% else %>No email restriction.<% end %> <%= status_label(@invitation.status) %></p>
  <p>This invitation grants management access only at <%= @invitation.target.name %>.<% if @invitation.email.present? %> The recipient must register or sign in using the invited email address.<% end %> It expires in 30 days and can be accepted once.</p>
  <% if @token %>
    <p>Copy this private link now; it will not be shown again. Share it only with the invited recipient.</p>
    <p><%= label_tag :invitation_link, "Private Invitation Link" %><span class="copy-field"><%= text_field_tag :invitation_link, coordinator_invitation_url(token: @token), readonly: true %><%= copy_button(target: "invitation_link", label: "private invitation link") %></span></p>
  <% end %>
  <% if @invitation.status == "Pending" %>
    <%= button_to "Revoke Invitation", polymorphic_path([@invitation.target, @invitation]), method: :delete %>
  <% end %>
  <p><%= link_to "Back to Invite a Coordinator", new_polymorphic_path([@invitation.target, :coordinator]) %></p>
</main>
