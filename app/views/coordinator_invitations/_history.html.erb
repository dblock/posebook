<% if @invitations.any? %>
  <section>
    <h2>Coordinator Invitations</h2>
    <% @invitations.each do |invitation| %>
      <p><%= copyable(invitation.email, label: "invited email") { link_to invitation.email, polymorphic_path([invitation.target, invitation]) } %> <%= status_label(invitation.status) %></p>
      <% if invitation.status == "Pending" %>
        <%= button_to "Revoke Invitation", polymorphic_path([invitation.target, invitation]), method: :delete %>
      <% end %>
    <% end %>
  </section>
<% end %>
