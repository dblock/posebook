<main>
  <%= render "shared/directory_navigation", active: "venues" %>
  <h1>Venues</h1>
  <div class="location-cards">
    <% @venues.each do |venue| %><%= render "card", venue: venue %><% end %>
  </div>
  <% if @venues.empty? %><p><%= current_user ? "No venues assigned. Contact a coordinator for access." : "No venues yet." %></p><% end %>
</main>
