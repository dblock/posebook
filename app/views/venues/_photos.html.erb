<% photos = (editable ? venue.photos : venue.photos.visible).order_by(created_at: :asc).to_a %>
<%= render "shared/photo_gallery", photos: photos, editable: editable, upload_url: venue_photos_path(venue), scope: :venue_photo,
           photo_url: ->(photo, **options) { venue_photo_path(venue, photo, **options) },
           description: ->(index) { "#{venue.name} photo #{index + 1}" },
           primary_id: venue.primary_photo(photos)&.id, empty_text: "No venue photos yet.", figure_class: "venue-photo" %>
