<main>
  <%= render "navigation", venue: @venue, active: "view" %>
  <h1><%= @venue.name %></h1>
  <% unless @venue.active? %><p role="status"><%= t('locations.inactive') %></p><% end %>
  <p><%= link_to "Venue Link", venue_path(@venue) %></p>
  <%= render "card", venue: @venue, show_title: false %>
</main>
