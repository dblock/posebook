<main>
  <h1><%= @venue.name %></h1>
  <p><%= copyable(venue_url(@venue), label: "venue link") { link_to "Venue Link", venue_path(@venue) } %></p>
  <%= simple_format(@venue.address) %><%= copy_button(value: @venue.address, label: "address") %>
  <% if @venue.public_instagram_url %><p><%= copyable("@#{@venue.public_instagram_handle}", label: "Instagram handle") { link_to "@#{@venue.public_instagram_handle}", @venue.public_instagram_url, target: "_blank", rel: "noopener noreferrer" } %></p><% end %>
  <h2>Programs</h2>
  <% @venue.programs.order_by(name: :asc).each do |program| %>
    <p><%= link_to program.name, program %><br><%= program_schedule_summary(program) %></p>
  <% end %>
  <% if @venue.coordinated_by?(current_user) %>
    <p><%= link_to "Edit Venue", edit_venue_path(@venue) %> | <%= link_to "Create Program", new_venue_program_path(@venue) %></p>
  <% end %>
  <% if current_user&.system_admin? %><p><%= link_to "Venue Coordinators", venue_coordinators_path(@venue) %></p><% end %>
  <%= render "photos", venue: @venue, editable: @venue.coordinated_by?(current_user) %>
</main>
