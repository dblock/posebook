<main>
  <h1><%= @venue.name %></h1>
  <p>Shortcut: <%= link_to venue_shortcut_path(@venue), venue_shortcut_path(@venue) %></p>
  <%= simple_format(@venue.address) %>
  <dl>
    <dt>Time Zone</dt><dd><%= @venue.time_zone %></dd>
    <dt>Regular Start Time</dt><dd><%= drawing_time(@venue.start_time) %></dd>
    <dt>Model Pay</dt><dd><%= number_to_currency(@venue.model_pay) %> USD</dd>
    <dt>Booking Horizon</dt><dd><%= @venue.booking_horizon_months %> months</dd>
  </dl>
  <h2>Instructions</h2>
  <%= simple_format(@venue.instructions) %>
  <% if @my_booking %>
    <h2>Your Upcoming Booking</h2>
    <p><%= @my_booking.date.to_fs(:long) %> at <%= booking_time(@my_booking) %>. You can have one upcoming booking at this venue.</p>
    <p><%= link_to "Change Date", edit_venue_model_booking_path(@venue, @my_booking) %> | <%= link_to "Cancel Booking", cancellation_venue_model_booking_path(@venue, @my_booking) %></p>
  <% end %>
  <%= render "calendar", calendar: @calendar %>
  <%= render "booking_history" %>
  <p>Changes and cancellations require an explanation and retain every booking record. Automated reminders are not available yet.</p>
  <%= render "invitations" if @manage_schedule %>
  <% if @manage_schedule %>
    <p><%= link_to "Manage Schedule", venue_schedule_path(@venue) %></p>
  <% end %>

  <% if current_user.system_admin? %>
    <p><%= link_to "Edit Venue", edit_venue_path(@venue) %> | <%= link_to "Organizers", venue_organizers_path(@venue) %></p>
  <% end %>
</main>
