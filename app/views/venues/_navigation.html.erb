<% tabs = [["view", "View", venue_path(venue)]] %>
<% manager = venue.coordinated_by?(current_user) %>
<% actions = manager ? [["edit", "Edit", edit_venue_path(venue)]] : [] %>
<% actions += [["photos", "Photos", photos_venue_path(venue)], ["programs", "Programs", programs_venue_path(venue)]] %>
<% actions << ["new_program", "New Program", new_venue_program_path(venue)] if manager %>
<% if current_user&.system_admin? %>
  <% actions << ["coordinators", "Coordinators", (venue_coordinators_path(venue) if venue.memberships.coordinators.exists?)] %>
  <% actions << ["invite_coordinator", "Invite a Coordinator", new_venue_coordinator_path(venue)] %>
  <% actions << ["security", "Security", security_venue_path(venue)] %>
<% end %>
<% breadcrumbs = [["Venues", venues_path], [venue.name, venue_path(venue)]] %>
<% section = (tabs + actions).find { |key, _, _| key == active } %>
<% breadcrumbs << [section[1], section[2]] if section && active != "view" %>
<% breadcrumbs << [detail, nil] if local_assigns[:detail].present? && detail != section&.fetch(1) %>
<%= render "shared/page_navigation", breadcrumbs: breadcrumbs, tabs: tabs, actions: actions, active: active, tabs_class: "venue-tabs", label: "Venue navigation" %>
