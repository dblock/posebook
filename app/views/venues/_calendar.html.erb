<% content_for :head do %>
  <%= javascript_include_tag "calendar", defer: true %>
<% end %>
<% public_view = local_assigns.fetch(:public_view, true) %>
<section aria-label="Posing calendar" data-calendar data-calendar-context="<%= calendar_access_context(public_view, manager: @manage_schedule, venue: calendar.venue, booking: @my_booking) %>">
  <h2>Posing Calendar</h2>
  <%= render "venues/regular_schedule", venue: calendar.venue %>
  <nav aria-label="Calendar months">
    <% if calendar.month > calendar.today.beginning_of_month %>
      <%= link_to "Previous Month", calendar_month_path(calendar, calendar.month - 1.month, @changing_booking), data: { calendar_navigation: true } %>
    <% end %>
    <strong data-calendar-month tabindex="-1"><%= calendar.month.strftime("%B %Y") %></strong>
    <% if calendar.month < calendar.last_date.beginning_of_month %>
      <%= link_to "Next Month", calendar_month_path(calendar, calendar.month + 1.month, @changing_booking), data: { calendar_navigation: true } %>
    <% end %>
  </nav>
  <p>Dates and times use <%= calendar.venue.time_zone %>. Available days are shown in green; all other days are blocked.</p>
  <table class="calendar">
    <thead><tr><% Date::ABBR_DAYNAMES.each do |day| %><th scope="col"><%= day %></th><% end %></tr></thead>
    <tbody>
      <% calendar.weeks.each do |week| %>
        <tr>
          <% week.each do |date| %>
            <% booking = calendar.bookings[date] %>
            <% reason = calendar_day_reason(calendar, date, public_view: public_view) %>
            <% reason ||= booking.user_id == current_user&.id ? "Your booking" : "Already booked" if booking %>
            <% reason ||= "You are already scheduled" if @my_booking && !@changing_booking %>
            <% reason ||= @booking_access.paused? ? "Posing paused" : "Invitation required" if @booking_access&.model? && !@can_book %>
            <td data-date="<%= date.iso8601 %>" class="<%= reason ? "blocked" : "available" %>">
              <time datetime="<%= date.iso8601 %>"><%= date.day %></time>
              <% if (clock = calendar_time(calendar, date)) %><strong><%= clock %></strong><br><% end %>
              <% if booking && public_view %><span>Booked</span><% else %><span><%= reason ? "Blocked" : "Available" %></span><% end %>
              <%= render "venues/booked_model", booking: booking, manager: @manage_schedule if booking %>
              <%= render "venues/attendance_status", booking: booking, private_view: !public_view && (@manage_schedule || booking.user_id == current_user&.id) if booking %>
              <% if booking && @manage_schedule %><%= link_to "Edit Booking", edit_venue_organizer_booking_path(calendar.venue, booking) %><% end %>
              <% if reason && !(public_view && booking) %><small><%= reason %></small><% end %>
              <% if !public_view && calendar.schedule.exceptions[date]&.mode == "open" %><small><%= calendar.schedule.exceptions[date].reason %></small><% end %>
              <% if !reason && @changing_booking %>
                <%= button_tag "Choose", type: "submit", form: "booking-change-form", name: "date", value: date.iso8601, aria: { label: "Choose #{date.iso8601}" } %>
              <% elsif !reason && @can_book %>
                <%= button_to "Book", venue_model_bookings_path(calendar.venue), params: { date: date.iso8601 }, aria: { label: "Book #{date.iso8601}" } %>
              <% end %>
              <% if @manage_schedule && date.between?(calendar.today, calendar.last_date) %>
                <%= link_to "Edit Day", venue_schedule_path(calendar.venue, date: date.iso8601), aria: { label: "Edit #{date.iso8601}" } %>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
