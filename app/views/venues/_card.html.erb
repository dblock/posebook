<article class="location-card venue-card">
  <% show_photo = local_assigns.fetch(:show_photo, true) %>
  <% photo = venue.primary_photo if show_photo %>
  <% if photo %>
    <figure class="location-card-photo" data-photo-series>
      <%= render "shared/photo_series", owner: venue, photo: photo, name: venue.name %>
    </figure>
  <% elsif show_photo == true %>
    <%= link_to venue_path(venue), class: "location-card-photo" do %>
      <%= image_tag "venue-placeholder.svg", width: 400, height: 400, loading: "lazy", alt: "No photo for #{venue.name}" %>
    <% end %>
  <% end %>
  <div class="location-card-summary">
    <% unless venue.active? %><p><%= status_label("Inactive") %></p><% end %>
    <% if local_assigns.fetch(:show_title, true) %><h2><%= link_to venue.name, venue_path(venue) %></h2><% end %>
    <%= render "venues/location", venue: venue, show_name: false %>
  </div>
</article>
