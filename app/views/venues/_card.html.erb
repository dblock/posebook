<article class="location-card venue-card">
  <% if (photo = venue.primary_photo) %>
    <%= link_to venue_path(venue), class: "location-card-photo" do %>
      <%= image_tag venue_photo_path(venue, photo, thumbnail: 1), width: 400, height: 400,
                    loading: "lazy", alt: "#{venue.name} primary photo" %>
    <% end %>
  <% end %>
  <div class="location-card-summary">
    <% if local_assigns.fetch(:show_title, true) %><h2><%= link_to venue.name, venue_path(venue) %></h2><% end %>
    <%= render "venues/information", venue: venue %>
  </div>
</article>
