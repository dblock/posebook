<% if calendar_day_empty?(calendar, date) %>
  <td data-date="<%= date.iso8601 %>"></td>
<% else %>
  <% reason = calendar_day_reason(calendar, date, public_view: public_view, manager: @manage_schedule) %>
  <% booking = calendar.displayed_bookings[date] unless reason == "Future" %>
  <% reason ||= booking.user_id == current_user&.id ? "Your booking" : "Already booked" if booking %>
  <% reason ||= "You are already scheduled" if @my_booking && !@changing_booking %>
  <% reason ||= @booking_access.paused? ? "Posing paused" : "Invitation required" if @booking_access&.model? && !@can_book %>
  <% reason ||= calendar.gender_blocked_reason(date, current_user, excluding: @changing_booking&.id) if !public_view && @can_book %>
  <% label = calendar_day_label(booking, reason) %>
  <td data-date="<%= date.iso8601 %>" class="<%= calendar_day_class(booking, reason) %>">
    <time datetime="<%= date.iso8601 %>"><%= date.day %></time>
    <% if reason != "Future" && (clock = calendar_time(calendar, date)) %><strong><%= clock %></strong><br><% end %>
    <span><%= label %></span>
    <%= render "venues/booked_model", booking: booking, manager: @manage_schedule if booking %>
    <%= render "venues/attendance_status", booking: booking, private_view: !public_view && (@manage_schedule || booking.user_id == current_user&.id) if booking %>
    <% if booking && @manage_schedule && booking.ends_at > Time.current %><%= link_to "Edit Booking", edit_venue_organizer_booking_path(calendar.venue, booking) %><% end %>
    <% if reason && reason != label && !(public_view && booking) %><small><%= reason %></small><% end %>
    <% if reason != "Future" && !public_view && calendar.schedule.exceptions[date]&.mode == "open" %><small><%= calendar.schedule.exceptions[date].reason %></small><% end %>
    <% if !reason && @changing_booking %>
      <%= button_tag "Choose", type: "submit", form: "booking-change-form", name: "date", value: date.iso8601, aria: { label: "Choose #{date.iso8601}" } %>
    <% elsif !reason && @can_book %>
      <%= button_to "Book", venue_model_bookings_path(calendar.venue), params: { date: date.iso8601 }, aria: { label: "Book #{date.iso8601}" } %>
    <% end %>
    <% if @manage_schedule && !booking && calendar.blocked_reason(date).nil? %>
      <%= link_to "Schedule Model", new_venue_organizer_booking_path(calendar.venue, date: date.iso8601), aria: { label: "Schedule model #{date.iso8601}" } %>
    <% end %>
    <% if @manage_schedule && date.between?(calendar.today, calendar.last_date) %>
      <%= link_to "Edit Day", venue_schedule_path(calendar.venue, date: date.iso8601), aria: { label: "Edit #{date.iso8601}" } %>
    <% end %>
  </td>
<% end %>
