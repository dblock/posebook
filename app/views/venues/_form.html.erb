<%= render "shared/errors", record: venue %>
<%= form_with model: venue do |form| %>
  <p><%= form.label :name %><br><%= form.text_field :name, required: true, maxlength: 100 %></p>
  <p><%= form.label :custom_slug, "Shortcut" %><br><%= form.text_field :custom_slug, maxlength: 100, placeholder: venue.name.to_s.to_url %></p>
  <p><%= form.label :address %><br><%= form.text_area :address, required: true, maxlength: 500 %></p>
  <p><%= form.label :google_maps_url, "Google Maps Link" %><br><%= form.url_field :google_maps_url, maxlength: 2048,
                                                                                            placeholder: "https://maps.app.goo.gl/..." %></p>
  <p><%= form.label :instagram_handle, "Instagram" %><br><%= form.text_field :instagram_handle, maxlength: 200, placeholder: "@yourvenue" %></p>
  <%= form.submit venue.persisted? ? "Save Venue" : "Create Venue" %>
<% end %>
