<main>
  <%= render "navigation", venue: @venue, active: "edit" %>
  <h1>Edit Venue</h1>
  <%= render "form", venue: @venue %>
  <%= render "shared/location_activation", location: @venue, path: venue_path(@venue), label: "Venue" if current_user.system_admin? %>
  <p><%= link_to "Back to Venue", venue_path(@venue) %></p>
</main>
