<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Posebook" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Posebook">
    <%= favicon_link_tag "posebook-favicon.png", rel: "icon", type: "image/png", sizes: "64x64" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tag :app %>
  </head>

  <body>
    <nav aria-label="Account">
      <%= link_to root_path, class: "brand" do %>
        <%= image_tag "posebook-logo.png", alt: "", width: 64, height: 64 %>
        <span>Posebook</span>
      <% end %>
      <% if current_user %>
        <span><%= current_user.name %></span>
        <%= link_to "Profile", profile_path %>
        <%= link_to "Venues", venues_path %>
        <%= link_to "Users", admin_users_path if current_user.system_admin? %>
        <%= button_to "Sign Out", session_path, method: :delete %>
      <% end %>
    </nav>
    <% flash.each do |type, message| %>
      <p role="<%= type == "alert" ? "alert" : "status" %>"><%= message %></p>
    <% end %>
    <%= yield %>
  </body>
</html>
