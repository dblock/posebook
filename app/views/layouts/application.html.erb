<!DOCTYPE html>
<html lang="en" data-theme="caramellatte">
  <head>
    <title><%= content_for(:title) || "Posebook" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Posebook">
    <%= favicon_link_tag "posebook-favicon.png", rel: "icon", type: "image/png", sizes: "64x64" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tag :app %>
  </head>

  <body>
    <header class="site-header">
      <nav class="site-nav" aria-label="Account">
        <%= link_to root_path, class: "brand" do %>
          <%= image_tag "posebook-logo.png", alt: "", width: 64, height: 64 %>
          <span>Posebook</span>
        <% end %>
        <% if current_user %>
          <%= link_to current_user.name, profile_path, class: "nav-account", aria: { label: "Profile for #{current_user.name}" } %>
          <div class="nav-links">
            <%= link_to "Venues", venues_path %>
            <%= button_to "Sign Out", session_path, method: :delete %>
          </div>
        <% end %>
      </nav>
    </header>
    <div class="page-shell">
      <% flash.each do |type, message| %>
        <p class="flash <%= "flash-alert" if type == "alert" %>" role="<%= type == "alert" ? "alert" : "status" %>"><%= message %></p>
      <% end %>
      <%= yield %>
    </div>
    <footer class="site-footer">
      <nav aria-label="Information">
        <span>Copyright &copy; <%= Time.current.year %> Vestris LLC.</span>
        <%= link_to "About", about_path %>
        <%= link_to "Privacy Policy", privacy_path %>
        <%= link_to "Terms of Service", terms_path %>
      </nav>
    </footer>
    <%= render "shared/photo_preview" %>
    <%= javascript_include_tag "clipboard", defer: true %>
  </body>
</html>
