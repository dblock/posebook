<aside class="rescheduling-notice" aria-labelledby="rescheduling-notice-title">
  <h3 id="rescheduling-notice-title">Contact an Organizer Before Rescheduling</h3>
  <% if local_assigns.fetch(:urgent, false) %><p><strong>Please contact an organizer ASAP. Your attendance has not been confirmed.</strong></p><% end %>
  <p>Your drawing is five days away or sooner. Please contact an organizer so we can work out a new date together. Online rescheduling is unavailable.</p>
  <% organizers = venue_organizer_contacts(venue) %>
  <% if organizers.any? %>
    <ul>
      <% organizers.each do |organizer| %>
        <li><strong><%= organizer.name %></strong>: <%= mail_to organizer.email %><% if organizer.phone.present? %> &middot; <%= link_to organizer.phone, "tel:#{organizer.phone}" %><% end %></li>
      <% end %>
    </ul>
  <% else %>
    <p>No organizer contact details are listed. Please contact the venue directly.</p>
  <% end %>
</aside>
