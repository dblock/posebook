<main>
  <h1>Cancel Your Booking</h1>
  <%= render "drawing_sessions/regular_schedule", drawing_session: @drawing_session %>
  <p><%= @booking.date.to_fs(:long) %> at <%= booking_time(@booking) %>, <%= @drawing_session.name %>. Your booking and explanation will remain in the history.</p>
  <%= form_with url: cancel_drawing_session_model_booking_path(@drawing_session, @booking) do %>
    <%= hidden_field_tag :booking_version, request.get? ? @booking.lock_version : params[:booking_version] %>
    <p><%= label_tag :reason, "Explanation" %><br><%= text_area_tag :reason, params[:reason], required: true, maxlength: 2000, rows: 3 %></p>
    <%= submit_tag "Cancel Booking" %>
  <% end %>
  <p><%= link_to "Keep My Booking", drawing_session_path(@drawing_session) %></p>
</main>
