<main>
  <h1>Change Your Posing Date</h1>
  <%= render "drawing_sessions/regular_schedule", drawing_session: @drawing_session %>
  <p>Your current booking is <%= @booking.date.to_fs(:long) %> at <%= booking_time(@booking) %>, <%= @drawing_session.name %>. It stays reserved unless your new date is successfully booked.</p>
  <% if @booking.rescheduling_locked? %>
    <%= render "model_bookings/rescheduling_notice", drawing_session: @drawing_session %>
  <% else %>
    <%= form_with url: drawing_session_model_booking_path(@drawing_session, @booking), method: :patch, id: "booking-change-form" do %>
          <%= hidden_field_tag :booking_version, request.get? ? @booking.lock_version : params[:booking_version] %>
      <p>Plans changed? Not a problem. Tell us, then choose an available date below.</p>
      <p><%= label_tag :reason, "What changed?" %><br><%= text_area_tag :reason, params[:reason], required: true, maxlength: 2000, rows: 3 %></p>
    <% end %>
    <%= render "drawing_sessions/calendar", calendar: @calendar, public_view: false %>
  <% end %>
  <p><%= link_to "Keep Current Date", drawing_session_path(@drawing_session) %></p>
</main>
