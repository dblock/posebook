<main>
  <%= render "programs/navigation", program: @program, active: "exceptions" %>
  <h1>Exceptions</h1>
  <% if @exceptions.any? %>
    <p class="scroll-hint">Scroll horizontally to view all schedule details.</p>
    <div class="table-scroll" role="region" aria-label="Schedule exceptions" tabindex="0">
      <table>
        <thead><tr><th>Date</th><th>Change</th><th>Time</th><th>Explanation</th><th></th></tr></thead>
        <tbody>
          <% @exceptions.each do |exception| %>
            <tr>
              <td><%= render "shared/date", value: exception.date, zone: @program.time_zone, format: :compact %></td>
              <td><%= status_label(exception.mode.humanize) %><%= " schedule restored" if exception.mode == "regular" %></td>
              <td><%= format_start_time(exception.start_time) if exception.start_time %><% if exception.end_time %> - <%= format_start_time(exception.end_time) %><%= " next day" if exception.end_time < exception.start_time %><% end %></td>
              <td><%= exception.reason %></td>
              <td><%= link_to "Edit", program_schedule_path(@program, date: exception.date.iso8601) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p>No schedule exceptions.</p>
  <% end %>
</main>
