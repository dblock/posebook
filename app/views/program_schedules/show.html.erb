<main>
  <%= render "programs/navigation", program: @program, active: "calendar", detail: "Manage Schedule" %>
  <h1><%= @program.program_label.titleize %> Schedule</h1>
  <%= render "programs/regular_schedule", program: @program %>
  <p>Open an extra date, change one <%= @program.program_label.downcase %>'s time, close a date, or restore its regular weekday schedule. A short explanation is required and retained. Closing a booked date cancels that booking; time changes keep the <%= @program.participant_label.downcase %> booked. Automated notifications are not available yet.</p>
  <%= render "shared/errors", record: @exception %>
  <%= form_with model: @exception, scope: :schedule, url: program_schedule_path(@program), method: :patch do |form| %>
    <p><%= form.label :date %><br><%= form.date_field :date, required: true, min: @calendar.today, max: @calendar.last_date %></p>
    <p><%= form.label :mode, "Change" %><br><%= form.select :mode, [["Open / Change Time", "open"], ["Close Date", "closed"], ["Use Regular Schedule", "regular"]] %></p>
    <p><%= form.label :start_time, "Start Time" %><br><%= form.time_field :start_time, step: 60 %><br><small>Required for Open / Change Time; ignored for the other changes. Uses <%= @program.time_zone %>.</small></p>
    <p><%= form.label :end_time, "End Time (optional)" %><br><%= form.time_field :end_time, step: 60 %><br><small>An earlier end time means the next day. Leave blank for no end time; ignored unless opening or changing a date.</small></p>
    <p><%= form.label :reason, "Explanation" %><br><%= form.text_area :reason, required: true, maxlength: 200, rows: 2 %></p>
    <%= form.submit "Save Schedule" %>
    <p><%= link_to "Cancel", program_path(@program, section: "calendar") %></p>
  <% end %>
</main>
