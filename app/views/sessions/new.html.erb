<main>
  <h1>Sign In</h1>
  <%= form_with url: session_path do |form| %>
    <p><%= form.label :email %><br><%= form.email_field :email, required: true, autocomplete: "email" %></p>
    <p><%= form.label :password %><br><%= form.password_field :password, required: true, autocomplete: "current-password" %></p>
    <%= form.submit "Sign In" %>
  <% end %>
  <p><%= link_to "Forgot your password?", new_password_reset_path %></p>
</main>
