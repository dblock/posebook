<main>
  <h1><%= @program.participant_label.pluralize.titleize %> at <%= @program.name %></h1>
  <%= render "programs/regular_schedule", program: @program %>
  <p class="participant-counts"><strong><%= @roster.counts[:total] %> total <%= @program.participant_label.pluralize.downcase %></strong> &middot; <%= @roster.counts[:available] %> <%= status_label("available") %> &middot; <%= @roster.counts[:booked] %> <%= status_label("booked") %> &middot; <%= @roster.counts[:paused] %> <%= status_label("paused") %> &middot; <%= @roster.counts[:inactive] %> <%= status_label("inactive") %></p>
  <%= button_to "Invite All Available #{@program.participant_label.pluralize.titleize} (#{@roster.counts[:available]})", invite_all_program_participants_path(@program, page: @roster.page), disabled: @roster.counts[:available].zero? %>
  <p>Invites available <%= @program.participant_label.pluralize.downcase %> across <strong>all pages</strong>, not just the <%= @program.participant_label.pluralize.downcase %> shown below.</p>
  <details class="participant-help">
    <summary>How Invitations and Pauses Work</summary>
    <p>Invite <%= @program.participant_article %> <%= @program.participant_label.downcase %> to choose one booking date. Cancellation and rescheduling keep that invitation valid until a <%= @program.program_label.downcase %> is completed. Finishing a <%= @program.program_label.downcase %> never automatically permits another booking.</p>
    <p>Paused <%= @program.participant_label.pluralize.downcase %> keep their existing booking and can cancel it, but cannot book or reschedule until resumed. Resuming does not issue a new invitation. Pause explanations remain private to <%= @program.program_label.downcase %> organizers and system admins.</p>
    <p>Sends email and enables booking now for active, unpaused <%= @program.participant_label.pluralize.downcase %> without an upcoming booking. Booked, paused, and inactive accounts are skipped. If email fails, access remains enabled so you can contact the <%= @program.participant_label.downcase %> directly or retry.</p>
    <p>Counts group inactive accounts first, then paused <%= @program.participant_label.pluralize.downcase %>, then booked <%= @program.participant_label.pluralize.downcase %>. Available includes <%= @program.participant_label.pluralize.downcase %> already invited who have not booked yet. Availability is checked again when invitations are sent.</p>
  </details>
  <% if @memberships.any? %>
    <p>Showing <%= @roster.first_number %>&ndash;<%= @roster.last_number %> of <%= @roster.counts[:total] %> <%= @program.participant_label.pluralize.downcase %></p>
    <p class="scroll-hint">Scroll horizontally to view <%= @program.participant_label.downcase %> access and actions.</p>
    <div class="table-scroll" role="region" aria-label="<%= @program.program_label.titleize %> <%= @program.participant_label.pluralize.downcase %>" tabindex="0">
      <table class="participant-roster">
        <thead><tr><th><%= @program.participant_label.titleize %></th><th>Booking Access</th><th>Actions</th></tr></thead>
        <tbody>
          <% @memberships.each do |membership| %>
            <% access = @roster.access_for(membership) %>
            <tr data-membership="<%= membership.id %>">
              <td><strong><%= membership.user.name %></strong><br><span class="participant-email"><%= membership.user.email %></span></td>
              <td>
                <% if access.booking && !access.paused? && membership.user.active? %>
                  <%= render "programs/booking_status", booking: access.booking, private_view: true %>
                  on <%= access.booking.date.iso8601 %> at <%= booking_time(access.booking) %>
                <% else %>
                  <%= status_label(access.status) %>
                  <% if access.booking %><br>Booking retained: <%= access.booking.date.iso8601 %> at <%= booking_time(access.booking) %> (<%= access.booking.display_status %>)<% end %>
                  <% if access.booking&.attendance_overdue? %><small class="attendance-warning" role="status">Please contact an organizer ASAP.</small><% end %>
                <% end %>
                <% if membership.participant_pause_reason.present? %>
                  <details><summary>Pause note</summary><p>Last pause: <%= membership.participant_pause_reason %></p></details>
                <% end %>
              </td>
              <td>
                <div class="participant-actions">
                  <% if membership.user.profile_photos.any? %><%= link_to "View Photos", participant_path(membership.user) %><% end %>
                  <% if membership.user.active? && !access.paused? && !access.booking %>
                    <%= button_to "Invite to Book", invite_program_participant_path(@program, membership, page: @roster.page) %>
                  <% end %>
                  <% if access.paused? %>
                    <%= button_to "Resume #{@program.participant_label.titleize}", resume_program_participant_path(@program, membership, page: @roster.page) %>
                  <% else %>
                    <details class="participant-pause">
                      <summary>Pause <%= @program.participant_label.titleize %></summary>
                      <%= form_with url: pause_program_participant_path(@program, membership, page: @roster.page) do |form| %>
                        <%= form.label :reason, "Pause explanation", for: "pause-reason-#{membership.id}" %>
                        <%= form.text_area :reason, id: "pause-reason-#{membership.id}", required: true, maxlength: 200, rows: 2 %>
                        <%= form.submit "Pause #{@program.participant_label.titleize}" %>
                      <% end %>
                    </details>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @roster.total_pages > 1 %>
      <nav class="participant-pagination" aria-label="<%= @program.participant_label.titleize %> pages">
        <% if @roster.page > 1 %><%= link_to "Previous", program_participants_path(@program, page: @roster.page - 1), rel: "prev" %><% end %>
        <span>Page <%= @roster.page %> of <%= @roster.total_pages %></span>
        <% if @roster.page < @roster.total_pages %><%= link_to "Next", program_participants_path(@program, page: @roster.page + 1), rel: "next" %><% end %>
      </nav>
    <% end %>
  <% else %>
    <p>No <%= @program.participant_label.pluralize.downcase %> assigned.</p>
  <% end %>
  <p><%= link_to "Invite a New #{@program.participant_label.titleize}", new_program_participant_invitation_path(@program) %> | <%= link_to "Back to #{@program.program_label.titleize}", program_path(@program) %></p>
</main>
