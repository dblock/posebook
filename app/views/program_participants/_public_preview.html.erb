<% visible = participant.active? %>
<section class="participant-profile-card" data-public-preview data-public-preview-visible="<%= visible %>" data-public-preview-fallback="<%= participant.display_name if visible %>">
  <h2>Public Card Preview</h2>
  <% unless visible %><p>This account is inactive and hidden publicly.</p><% end %>
  <p><strong data-public-preview-name aria-live="polite" aria-atomic="true"><%= membership.participant_public_name %></strong></p>
  <% if visible && (url = participant.public_instagram_url) %>
    <p data-public-preview-instagram<%= " hidden" if membership.instagram_hidden? %>><%= link_to "@#{participant.public_instagram_handle}", url, target: "_blank", rel: "noopener noreferrer" %></p>
  <% end %>
  <% photos = participant.public_photos %>
  <% if photos.any? %>
    <div class="photo-gallery" data-public-preview-photos<%= " hidden" if membership.photos_hidden? %>>
      <% photos.each_with_index do |photo, index| %>
        <figure class="profile-photo">
          <%= render "shared/photo_thumbnail", full_url: participant_photo_path(participant, photo),
                     thumbnail_url: participant_photo_path(participant, photo, thumbnail: 1),
                     description: "Public profile photo #{index + 1}" %>
        </figure>
      <% end %>
    </div>
  <% end %>
</section>
