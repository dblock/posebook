<% content_for :head do %>
  <%= javascript_include_tag "participant-preview", defer: true %>
<% end %>
<main data-edit-in-place>
  <%= render "programs/navigation", program: @program, active: "participants", detail: "Edit #{@program.participant_label.titleize}" %>
  <h1>Edit <%= @program.participant_label.titleize %></h1>
  <%= render "shared/errors", record: @membership %>
  <div class="participant-editor" data-participant-editor>
    <div>
      <%= form_with url: program_participant_path(@program, @membership, cursor: params[:cursor], status: params[:status]), method: :patch, scope: :participant do |form| %>
        <p><%= form.label :display_name, "Display Name" %><br><%= form.text_field :display_name, value: @membership.display_name_override, placeholder: @participant.display_name, maxlength: 100 %></p>
        <% handle = @participant.public_instagram_handle %>
        <p><label><%= form.check_box :instagram_hidden, checked: @membership.instagram_hidden?, disabled: handle.nil? %> Hide Instagram Handle<%= " (@#{handle})" if handle %></label></p>
        <p><label><%= form.check_box :photos_hidden, checked: @membership.photos_hidden?, disabled: @participant.public_photos.none? %> Hide Photos</label></p>
        <p><%= form.label :notes, "Coordinator Notes (Private to This Program)" %><br><%= form.text_area :notes, value: @membership.notes, rows: 6 %></p>
        <%= form.submit "Save #{@program.participant_label.titleize}" %>
      <% end %>
      <p><%= link_to "Cancel", program_participants_path(@program, cursor: params[:cursor], status: params[:status]) %></p>
    </div>
    <aside aria-label="Current profile and public preview">
      <%= render "public_preview", participant: @participant, membership: @membership %>
      <section class="participant-profile-card" data-current-profile>
        <h2>User Profile</h2>
        <%= render "shared/participant_identity", participant: @participant %>
        <dl>
          <dt>Display Name</dt><dd><%= @participant.display_name.presence || "Not set (To be announced)" %></dd>
          <dt>Phone</dt><dd><%= @participant.display_phone.presence || "Not provided" %></dd>
          <dt>Instagram Tagging</dt><dd><%= status_label(@participant.instagram_tagging_allowed? ? "Enabled" : "Off") %></dd>
        </dl>
      </section>
    </aside>
  </div>
</main>
