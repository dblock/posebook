<main>
  <%= render "navigation", active: "view" %>
  <h1>Profile</h1>
  <dl>
    <dt>Name</dt><dd><%= @user.name %></dd>
    <dt>Email</dt><dd><%= @user.email %></dd>
    <dt>Phone (unverified)</dt><dd><%= @user.phone.presence || "Not provided" %></dd>
    <dt>Gender (private)</dt><dd><%= @user.gender&.capitalize || "Not selected" %></dd>
    <dt>Public Identity</dt><dd><%= status_label(@user.public_profile_private? ? "Private" : "Public") %><% if @user.public_profile_private? %>: To be announced on public calendars<% end %></dd>
    <dt>Public Display Name</dt><dd><%= @user.public_name %><%= " (using your name)" if !@user.public_profile_private? && @user.display_name.blank? %></dd>
    <dt>Instagram Handle</dt><dd><% if (url = InstagramProfile.url(@user.instagram_handle)) %><%= link_to "@#{@user.instagram_handle}", url, target: "_blank", rel: "noopener noreferrer" %><% else %>Not provided<% end %></dd>
    <dt>Instagram Tagging</dt><dd><% if @user.public_profile_private? %><%= status_label("Hidden") %> while your information is private<% elsif @user.instagram_tagging_allowed? %><%= status_label("Enabled") %>: handle appears in announcements and program calendars<% else %><%= status_label("Off") %>: Instagram stays private<% end %></dd>
  </dl>
  <% if @user.pending_email.present? %>
    <p><%= status_label("Pending") %> email verification for <%= @user.pending_email %>. Your current email is still <%= @user.email %>.</p>
  <% end %>
  <% if @user.profile_photos.any? %>
    <section aria-labelledby="profile-photos-heading">
      <h2 id="profile-photos-heading">Photos</h2>
      <div class="photo-gallery">
        <% @user.profile_photos.each_with_index do |photo, index| %>
          <figure class="profile-photo" data-photo="<%= photo.id %>">
            <%= render "shared/photo_thumbnail", full_url: participant_photo_path(@user, photo),
                       thumbnail_url: participant_photo_path(@user, photo, thumbnail: 1),
                       description: "Profile photo #{index + 1}" %>
            <figcaption><%= status_label(photo.public? ? "Public" : "Private") %></figcaption>
          </figure>
        <% end %>
      </div>
    </section>
  <% end %>
</main>
