<% bookings = dashboard.upcoming_bookings %>
<% bookings.each do |booking| %>
  <%= render "bookings/upcoming", program: booking.program, booking: booking,
             can_book: dashboard.access_for(booking.program_id).allowed?, show_venue: true %>
<% end %>
<% if bookings.empty? %><p>No upcoming bookings.</p><% end %>
<section aria-labelledby="bookable-programs-heading">
  <h2 id="bookable-programs-heading">Programs You Can Book</h2>
  <% programs = dashboard.bookable_programs %>
  <div class="location-cards bookable-programs">
    <% programs.each do |program| %><%= render "programs/card", program: program, bookable: true %><% end %>
  </div>
  <% if programs.empty? %><p>No programs available to book. Contact a coordinator for a booking invitation.</p><% end %>
</section>
