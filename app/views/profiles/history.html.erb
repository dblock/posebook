<main>
  <%= render "profiles/navigation", user: @user, active: "history" %>
  <h1>History</h1>
  <% if @bookings.any? %>
    <p>Showing <%= @history.first_number %>&ndash;<%= @history.last_number %> of <%= @history.count %> bookings</p>
    <p class="scroll-hint">Scroll horizontally to view the full history.</p>
    <div class="table-scroll" role="region" aria-label="Booking history" tabindex="0">
      <table>
        <thead><tr><th>Program / Venue</th><th>Date / Time</th><th>Status</th><th>Explanation</th></tr></thead>
        <tbody>
          <% @bookings.each do |booking| %>
            <tr>
              <td><%= link_to booking.program.name, program_path(booking.program) %><br><%= link_to booking.program.venue.name, venue_path(booking.program.venue) %></td>
              <td><%= booking.date.iso8601 %><br><%= booking_time(booking) %><% if booking.previous_booking %><br>Moved from <%= booking.previous_booking.date.iso8601 %><% end %></td>
              <td><%= render "programs/booking_status", program: booking.program, booking: booking %></td>
              <td><%= render "bookings/explanation", booking: booking %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @history.total_pages > 1 %>
      <nav class="participant-pagination" aria-label="Booking history pages">
        <% if @history.page > 1 %><%= link_to "Previous", user_page_path(@user, "history", page: @history.page - 1), rel: "prev" %><% end %>
        <span>Page <%= @history.page %> of <%= @history.total_pages %></span>
        <% if @history.page < @history.total_pages %><%= link_to "Next", user_page_path(@user, "history", page: @history.page + 1), rel: "next" %><% end %>
      </nav>
    <% end %>
  <% else %>
    <p>No bookings yet.</p>
  <% end %>
</main>
