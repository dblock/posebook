  <% if @user.system_admin? %>
    <p>System admin accounts can't be deactivated.</p>
  <% else %>
    <p>Signs you out everywhere and hides your public profile. Your account and history are kept privately, and bookings aren't canceled.</p>
    <%= form_with url: account_deactivation_path, id: "deactivation-form", data: { navigate: true } do |form| %>
      <p><%= form.label :current_password, "Current Password", for: "deactivate-current-password" %><br><%= form.password_field :current_password, id: "deactivate-current-password", required: true, autocomplete: "current-password" %></p>
      <%= form.submit "Deactivate My Account" %>
    <% end %>
  <% end %>
