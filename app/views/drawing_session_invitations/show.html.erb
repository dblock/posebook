<main>
  <h1>Model Invitation</h1>
  <p><%= @drawing_session.name %> - <%= status_label(@invitation.status) %></p>
  <%= render "drawing_sessions/regular_schedule", drawing_session: @drawing_session %>
  <% if @token.present? %>
    <p><%= label_tag :invitation_link, "Invitation link (copy now)" %><br><%= url_field_tag :invitation_link, invitation_url(token: @token, **Rails.configuration.action_mailer.default_url_options), readonly: true %></p>
    <p>This link is shown only once. Share it privately with one model; they can create an account or sign in with an existing one.</p>
  <% else %>
    <p>The private link is only displayed when the invitation is created. Create a new invitation if you did not keep it.</p>
  <% end %>
  <p><%= link_to "Back to DrawingSession", drawing_session_path(@drawing_session) %></p>
</main>
