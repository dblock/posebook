<main>
  <h1>Posebook</h1>
  <% if current_user %><p>Welcome, <%= current_user.name %>.</p><% end %>
  <% if current_user && (applications = participant_dashboard.applications).any? %>
    <section class="homepage-applications" aria-label="Applications">
      <h2>Applications</h2>
      <%= render "participant_applications/table", applications: applications, user: current_user %>
    </section>
  <% end %>
  <% if @management_home %>
    <section class="submitted-applications" aria-label="Submitted applications" data-application-region>
      <h2>Submitted Applications</h2>
      <%= render "participant_applications/filter", url: root_path, status: @submitted_status %>
      <% if @submitted_applications.any? %>
        <%= render "participant_applications/table", applications: @submitted_applications, user: nil, show_applicant: true %>
      <% else %>
        <p>No applications in this view.</p>
      <% end %>
      <%= render "shared/pagination", pagination: @submitted_pagination, label: "Submitted application pages" %>
    </section>
    <h2>Programs You Manage</h2>
    <%= render "programs/managed", programs: @managed_programs %>
  <% elsif current_user %>
    <%= render "profiles/bookings", dashboard: participant_dashboard, read_only: false, all_programs: true %>
  <% else %>
    <%= render "shared/upcoming_sessions", sessions: @sessions %>
  <% end %>
  <% if current_user %>
    <% if @management_home %><p><%= current_user.system_admin? ? "You have the system admin role." : "You have coordinator access." %></p><% end %>
    <p><%= link_to "View Your Profile", profile_path %> for bookings, programs you can book, and history.</p>
    <p><%= link_to "View Venues", venues_path %> to explore your venues and their programs.</p>
  <% end %>
</main>
