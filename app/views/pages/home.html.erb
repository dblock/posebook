<main>
  <h1>Posebook</h1>
  <% if current_user %><p>Welcome, <%= current_user.name %>.</p><% end %>
  <% if @management_home %>
    <h2>Programs You Manage</h2>
    <%= render "programs/managed", programs: @managed_programs %>
  <% elsif current_user %>
    <%= render "profiles/bookings", dashboard: participant_dashboard, read_only: false, all_programs: true %>
  <% else %>
    <%= render "shared/upcoming_sessions", sessions: @sessions %>
  <% end %>
  <% if current_user %>
    <% if @management_home %><p><%= current_user.system_admin? ? "You have the system admin role." : "You have coordinator access." %></p><% end %>
    <p><%= link_to "View Your Profile", profile_path %> for bookings, programs you can book, and history.</p>
    <p><%= link_to "View Venues", venues_path %> to explore your venues and their programs.</p>
  <% end %>
</main>
