<main>
  <%= render "profiles/navigation", active: "applications" %>
  <h1>Application</h1>
  <p><strong>Program:</strong> <%= link_to @program.name, program_path(@program) %></p>
  <p><strong>Status:</strong> <%= @application.status_label %></p>
  <p><strong>Submitted On:</strong> <%= render "shared/date", value: @application.submitted_at || @application.created_at, zone: @program.time_zone %></p>
  <% if @application.status == "declined" %>
    <p>Coordinators may accept this application later; you do not need to apply again.</p>
  <% end %>
  <h2>Account Details</h2>
  <%= render "shared/account_details", user: @user %>
  <h2>Photos</h2>
  <%= render "shared/photo_gallery", photos: @photos, editable: false, upload_url: nil, scope: :profile_photo,
             photo_url: ->(photo, **options) { participant_photo_path(current_user, photo, **options) },
             description: ->(index) { "Profile photo #{index + 1}" }, show_status: false %>
  <% if @application.message.present? %><h2>Your Message</h2><%= simple_format(@application.message) %><% end %>
  <h2>History</h2>
  <%= render "events", events: @application.events.reorder(created_at: :desc, id: :desc), private_notes: false %>
  <% if @application.status == "withdrawn" && @program.applications_enabled? && @program.booking_active? %>
    <%= button_to "Resubmit", resubmit_program_participation_application_path(@program), params: { lock_version: @application.lock_version }, form: { class: "button_to application-resubmit" } %>
  <% end %>
</main>
