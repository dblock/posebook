<main>
  <%= render "profiles/navigation", active: "applications" %>
  <h1>Your Application to <%= @program.name %></h1>
  <p><strong>Status:</strong> <%= @application.status_label %></p>
  <% if @application.status == "accepted" %>
    <p>You are a participant. <%= link_to "View Calendar", program_path(@program, section: "calendar") %>. Existing booking rules and any account pause still apply.</p>
  <% elsif @application.status == "declined" %>
    <p>Not accepting right now. Coordinators may accept this application later; you do not need to apply again.</p>
  <% elsif @application.status == "withdrawn" %>
    <p>This application cannot be accepted. Application-only profile access has ended. Ask an organizer for an invitation if you wish to participate in the future.</p>
  <% else %>
    <p>Your application is awaiting review. No membership or booking access has been granted.</p>
  <% end %>
  <% if @application.message.present? %><h2>Your Message</h2><%= simple_format(@application.message) %><% end %>
  <% if %w[pending declined].include?(@application.status) %>
    <p>Withdrawing prevents later acceptance and ends application-only review of your profile and private photos. Existing participant access is unchanged. History is retained.</p>
    <%= button_to "Withdraw Application", program_participation_application_path(@program), method: :delete, params: { lock_version: @application.lock_version }, class: "secondary-action" %>
  <% end %>
  <h2>History</h2>
  <%= render "events", events: @application.events, private_notes: false %>
</main>
