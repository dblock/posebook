<main>
  <%= render "profiles/navigation", user: @user, active: "applications" %>
  <h1>Applications</h1>
  <% if @applications.empty? && @user == current_user %><p>Browse <%= link_to "Venues", venues_path %> to find programs accepting applications.</p><% end %>
  <%= render "participant_applications/table", applications: @applications, user: @user %>
  <%= render "shared/pagination", pagination: @pagination, label: "Application pages" %>
</main>
