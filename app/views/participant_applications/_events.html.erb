<div class="table-scroll" role="region" aria-label="Application history" tabindex="0">
  <table>
    <thead><tr><th>Event</th><th>Date</th><% if private_notes %><th>By</th><th>Private Reviewer Notes</th><% end %></tr></thead>
    <tbody>
      <% events.each do |event| %>
        <tr>
          <td><%= participation_event_label(event) %></td>
          <td><%= render "shared/date", value: event.created_at, zone: @program.time_zone, format: :compact %></td>
          <% if private_notes %>
            <td><%= participation_actor_label(event, local_assigns[:source]) %></td>
            <td><%= event.notes %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
