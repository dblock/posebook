<main>
  <%= render "programs/navigation", program: @program, active: "applications", detail: "Participation History" %>
  <h1>Participation History</h1>
  <p>Application decisions and accepted personal invitations retain their distinct origins. Earlier membership origins are not reconstructed.</p>
  <% if @events.empty? %>
    <p>No participation events yet.</p>
  <% else %>
    <div class="table-scroll" role="region" aria-label="Participation history" tabindex="0">
      <table class="participation-history">
        <thead><tr><th>Participant</th><th>Event</th><th>Date</th><th>By</th><th>Notes</th></tr></thead>
        <tbody>
          <% @events.each do |event| %>
            <% source = @sources[event.source_id] %>
            <tr>
              <td>
                <% if source.is_a?(ParticipantApplication) %>
                  <%= link_to participant_contact_label(source), program_application_path(@program, source) %>
                <% elsif source %>
                  <%= participant_contact_label(source) %>
                <% end %>
              </td>
              <td><%= participation_event_label(event) %></td>
              <td><time datetime="<%= event.created_at.iso8601 %>"><%= l(event.created_at.in_time_zone(@program.time_zone), format: :long) %></time></td>
              <td><%= participation_actor_label(event, source) %></td>
              <td><%= event.notes %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  <% if @page > 1 || @more %>
    <nav class="participant-pagination" aria-label="Participation history pages">
      <% if @page > 1 %><%= link_to "Previous", history_program_applications_path(@program, page: @page - 1), rel: "prev" %><% end %>
      <span>Page <%= @page %></span>
      <% if @more %><%= link_to "Next", history_program_applications_path(@program, page: @page + 1), rel: "next" %><% end %>
    </nav>
  <% end %>
</main>
