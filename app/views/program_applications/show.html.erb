<main>
  <%= render "programs/navigation", program: @program, active: "applications", detail: "Review" %>
  <h1>Review Application</h1>
  <% membership = @program.memberships.participants.where(user_id: @application.user_id).first if @application.status == "accepted" %>
  <p><%= link_to participant_contact_label(@application), membership ? edit_program_participant_path(@program, membership) : participant_path(@application.user_id) %> <%= status_label(@application.status_label) %></p>
  <p><strong>Submitted On:</strong> <%= render "shared/date", value: @application.submitted_at || @application.created_at, zone: @program.time_zone %></p>
  <% if membership %><p><%= link_to "View Profile", participant_path(@application.user_id) %></p><% end %>
  <% gallery = PhotoGallery.new(@application.user, current_user) if %w[pending declined].include?(@application.status) %>
  <% photos = gallery&.private_access? ? gallery.photos : [] %>
  <% if photos.any? %>
    <h2>Photos</h2>
    <%= render "shared/photo_gallery", photos: photos, editable: false, upload_url: nil, scope: :profile_photo,
               photo_url: ->(photo, **options) { participant_photo_path(@application.user_id, photo, **options) },
               description: ->(index) { "Profile photo #{index + 1}" }, show_status: true %>
  <% end %>
  <% if @application.message.present? %><h2>Applicant Message</h2><%= simple_format(@application.message) %><% end %>
  <% if %w[pending declined].include?(@application.status) %>
    <%= form_with url: program_application_path(@program, @application), method: :patch, scope: :participant_application do |form| %>
      <%= form.hidden_field :lock_version, value: @application.lock_version %>
      <p><%= form.label :notes, "Private Reviewer Notes (Optional)" %><br><%= form.text_area :notes, maxlength: 200, rows: 3 %><br><small>Visible only to this program's managers, never the applicant.</small></p>
      <p><%= form.button "Accept", name: "participant_application[status]", value: "accepted" %>
      <% if @application.status == "pending" %><%= form.button "Reject", name: "participant_application[status]", value: "declined" %><% end %></p>
    <% end %>
  <% end %>
  <% events = @application.events.reviewable.includes(:actor).reorder(created_at: :desc, id: :desc).to_a %>
  <% if events.any? %>
    <h2>History</h2>
    <%= render "participant_applications/events", events: events, private_notes: true, source: @application %>
  <% end %>
</main>
