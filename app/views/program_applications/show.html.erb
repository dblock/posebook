<main>
  <%= render "programs/navigation", program: @program, active: "applications", detail: "Review" %>
  <h1>Review Application</h1>
  <p><%= participant_contact_label(@application) %> - <strong><%= @application.status_label %></strong></p>
  <p>Contact details above are retained from submission.</p>
  <% if %w[pending declined].include?(@application.status) %>
    <p><%= link_to "Review Current Profile and Photos", participant_path(@application.user_id), target: "_blank", rel: "noopener" %>. Opens separately. Profile review does not permit editing photos.</p>
  <% end %>
  <% if @application.message.present? %><h2>Applicant Message</h2><%= simple_format(@application.message) %><% end %>
  <% if %w[pending declined].include?(@application.status) %>
    <%= form_with url: program_application_path(@program, @application), method: :patch, scope: :participant_application do |form| %>
      <%= form.hidden_field :lock_version, value: @application.lock_version %>
      <p><%= form.label :notes, "Private Reviewer Notes (Optional)" %><br><%= form.text_area :notes, maxlength: 200, rows: 3 %><br><small>Visible only to this program's managers, never the applicant.</small></p>
      <p><%= form.button "Accept", name: "participant_application[status]", value: "accepted" %>
      <% if @application.status == "pending" %><%= form.button "Not Now", name: "participant_application[status]", value: "declined", class: "secondary-action" %><% end %></p>
    <% end %>
    <p>Accept grants the same participation and initial booking access as an accepted invitation, without renewing an existing cycle or clearing a pause. Not Now keeps the application for later reconsideration.</p>
  <% end %>
  <h2>History</h2>
  <%= render "participant_applications/events", events: @application.events.includes(:actor), private_notes: true, source: @application %>
</main>
