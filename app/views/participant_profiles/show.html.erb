<main>
  <% if current_user == @user %><%= render "profiles/navigation", active: "photos" %><% end %>
  <h1><%= @gallery.private_access? ? @user.name : @user.public_name %> - Photos</h1>
  <% if @gallery.private_access? %>
    <p><%= @photos.length %> of <%= ProfilePhoto::LIMIT %> photos. Private photos are visible only to the account owner, system admins, and their program organizers.</p>
    <% if @user.public_profile_private? %>
      <p class="rescheduling-notice">Private Identity is on. All photos are hidden publicly, including photos marked Public.</p>
    <% end %>
  <% end %>
  <% if @gallery.editable? %>
    <p>New uploads are private. Choose which photos to make public. Photos are optimized for the web; click a square thumbnail to see the full image.</p>
    <% if @photos.length < ProfilePhoto::LIMIT %>
      <%= form_with url: participant_photos_path(@user), scope: :profile_photo, multipart: true do |form| %>
        <p><%= form.label :file, "New Photo" %><br><%= form.file_field :file, accept: "image/jpeg,image/png,image/webp", required: true %><br><small>JPEG, PNG, or WebP, up to 10 MB and 40 megapixels.</small></p>
        <%= form.submit "Upload Photo" %>
      <% end %>
    <% else %>
      <p>You have 10 photos. Delete one before uploading another.</p>
    <% end %>
  <% end %>
  <div class="photo-gallery">
    <% @photos.each_with_index do |photo, index| %>
      <figure class="profile-photo" data-photo="<%= photo.id %>">
        <%= render "shared/photo_thumbnail", full_url: participant_photo_path(@user, photo),
                   thumbnail_url: participant_photo_path(@user, photo, thumbnail: 1),
                   description: "Profile photo #{index + 1}" %>
        <% if @gallery.private_access? %>
          <figcaption><%= status_label(photo.public? ? "Public" : "Private") %></figcaption>
        <% end %>
        <% if @gallery.editable? %>
          <div class="photo-actions">
            <%= button_to photo.public? ? "Make Private" : "Make Public", participant_photo_path(@user, photo), method: :patch, params: { profile_photo: { public: photo.public? ? "0" : "1" } }, class: "secondary-action" %>
            <%= button_to "Delete Photo", participant_photo_path(@user, photo), method: :delete, class: "secondary-action" %>
          </div>
        <% end %>
      </figure>
    <% end %>
  </div>
  <% if @photos.empty? %><p>No photos yet.</p><% end %>
</main>
