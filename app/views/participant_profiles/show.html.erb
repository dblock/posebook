<main>
  <h1><%= @user.public_name %></h1>
  <% if @user.public_instagram_handle %>
    <dl class="participant-details">
      <dt>Instagram</dt><dd><%= link_to "@#{@user.public_instagram_handle}", @user.public_instagram_url,
                                       target: "_blank", rel: "noopener noreferrer" %></dd>
    </dl>
  <% end %>
  <% if @next_booking %>
    <h2>Next Booking</h2>
    <p><%= link_to @next_booking.program.name, program_path(@next_booking.program) %>,
      <time datetime="<%= @next_booking.scheduled_start.iso8601 %>"><%= @next_booking.date.strftime("%A, %B %-d, %Y") %></time>,
      <%= calendar_booking_time(@next_booking) %> (<%= @next_booking.time_zone %>)</p>
  <% end %>
  <%= render "shared/photo_gallery", photos: @photos, editable: false, upload_url: nil, scope: :profile_photo,
             photo_url: ->(photo, **options) { participant_photo_path(@user, photo, **options) },
             description: ->(index) { "Profile photo #{index + 1}" }, empty_text: "No public photos." %>
</main>
