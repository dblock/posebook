<main>
  <h1>Models at <%= @drawing_session.name %></h1>
  <%= render "drawing_sessions/regular_schedule", drawing_session: @drawing_session %>
  <p class="model-counts"><strong><%= @roster.counts[:total] %> total models</strong> &middot; <%= @roster.counts[:available] %> <%= status_label("available") %> &middot; <%= @roster.counts[:booked] %> <%= status_label("booked") %> &middot; <%= @roster.counts[:paused] %> <%= status_label("paused") %> &middot; <%= @roster.counts[:inactive] %> <%= status_label("inactive") %></p>
  <%= button_to "Invite All Available Models (#{@roster.counts[:available]})", invite_all_drawing_session_models_path(@drawing_session, page: @roster.page), disabled: @roster.counts[:available].zero? %>
  <p>Invites available models across <strong>all pages</strong>, not just the models shown below.</p>
  <details class="model-help">
    <summary>How Invitations and Pauses Work</summary>
    <p>Invite a model to choose one posing date. Cancellation and rescheduling keep that invitation valid until a drawing is completed. Finishing a drawing never automatically permits another booking.</p>
    <p>Paused models keep their existing booking and can cancel it, but cannot book or reschedule until resumed. Resuming does not issue a new invitation. Pause explanations remain private to drawing_session organizers and system admins.</p>
    <p>Sends email and enables booking now for active, unpaused models without an upcoming booking. Booked, paused, and inactive accounts are skipped. If email fails, access remains enabled so you can contact the model directly or retry.</p>
    <p>Counts group inactive accounts first, then paused models, then booked models. Available includes models already invited who have not booked yet. Availability is checked again when invitations are sent.</p>
  </details>
  <% if @memberships.any? %>
    <p>Showing <%= @roster.first_number %>&ndash;<%= @roster.last_number %> of <%= @roster.counts[:total] %> models</p>
    <p class="scroll-hint">Scroll horizontally to view model access and actions.</p>
    <div class="table-scroll" role="region" aria-label="Session models" tabindex="0">
      <table class="model-roster">
        <thead><tr><th>Model</th><th>Booking Access</th><th>Actions</th></tr></thead>
        <tbody>
          <% @memberships.each do |membership| %>
            <% access = @roster.access_for(membership) %>
            <tr data-membership="<%= membership.id %>">
              <td><strong><%= membership.user.name %></strong><br><span class="model-email"><%= membership.user.email %></span></td>
              <td>
                <%= status_label(access.status) %>
                <%= " at #{booking_time(access.booking)}" if access.booking && !access.paused? && membership.user.active? %>
                <%= render "drawing_sessions/attendance_status", booking: access.booking, private_view: true if access.booking %>
                <% if access.paused? && access.booking %><br>Booking retained: <%= access.booking.date.iso8601 %> at <%= booking_time(access.booking) %><% end %>
                <% if membership.model_pause_reason.present? %>
                  <details><summary>Pause note</summary><p>Last pause: <%= membership.model_pause_reason %></p></details>
                <% end %>
              </td>
              <td>
                <div class="model-actions">
                  <% if membership.user.profile_photos.any? %><%= link_to "View Photos", model_path(membership.user) %><% end %>
                  <% if membership.user.active? && !access.paused? && !access.booking %>
                    <%= button_to "Invite to Book", invite_drawing_session_model_path(@drawing_session, membership, page: @roster.page) %>
                  <% end %>
                  <% if access.paused? %>
                    <%= button_to "Resume Model", resume_drawing_session_model_path(@drawing_session, membership, page: @roster.page) %>
                  <% else %>
                    <details class="model-pause">
                      <summary>Pause Model</summary>
                      <%= form_with url: pause_drawing_session_model_path(@drawing_session, membership, page: @roster.page) do |form| %>
                        <%= form.label :reason, "Pause explanation", for: "pause-reason-#{membership.id}" %>
                        <%= form.text_area :reason, id: "pause-reason-#{membership.id}", required: true, maxlength: 200, rows: 2 %>
                        <%= form.submit "Pause Model" %>
                      <% end %>
                    </details>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @roster.total_pages > 1 %>
      <nav class="model-pagination" aria-label="Model pages">
        <% if @roster.page > 1 %><%= link_to "Previous", drawing_session_models_path(@drawing_session, page: @roster.page - 1), rel: "prev" %><% end %>
        <span>Page <%= @roster.page %> of <%= @roster.total_pages %></span>
        <% if @roster.page < @roster.total_pages %><%= link_to "Next", drawing_session_models_path(@drawing_session, page: @roster.page + 1), rel: "next" %><% end %>
      </nav>
    <% end %>
  <% else %>
    <p>No models assigned.</p>
  <% end %>
  <p><%= link_to "Invite a New Model", new_drawing_session_model_invitation_path(@drawing_session) %> | <%= link_to "Back to DrawingSession", drawing_session_path(@drawing_session) %></p>
</main>
