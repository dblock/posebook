<main>
  <h1><%= @program.program_label.titleize %> Coordinators at <%= @program.name %></h1>
  <%= render "programs/regular_schedule", program: @program %>
  <%= render "coordinator_invitations/form" %>
  <h2>Current Coordinators</h2>
  <% @coordinators.each do |membership| %>
    <p><%= membership.user.name %> (<%= membership.user.email %>)</p>
    <% unless membership.user.active? %><%= status_label("Inactive") %> account<% end %>
    <%= button_to "Remove Coordinator", program_coordinator_path(@program, membership), method: :delete %>
  <% end %>
  <%= render "coordinator_invitations/history" %>
  <p>Venue coordinators inherit access to every <%= @program.program_label.downcase %> at their venue. <%= @program.program_label.titleize %> coordinators cannot grant coordinator access.</p>
  <p><%= link_to "Back to #{@program.program_label.titleize}", program_path(@program) %></p>
</main>
