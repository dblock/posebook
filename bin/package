#!/usr/bin/env ruby
# frozen_string_literal: true

require 'net/http'
require 'open3'
require 'optparse'
require 'securerandom'

def docker!(*)
  output, errors, status = Open3.capture3('docker', *)
  raise "#{output}#{errors}" unless status.success?

  warn errors unless errors.empty?
  output.strip
end

def request(port, path)
  Net::HTTP.start('127.0.0.1', port, open_timeout: 2, read_timeout: 2) do |http|
    http.get(path, { 'Host' => 'enochs.dblock.org', 'X-Forwarded-Proto' => 'https' })
  end
end

def wait_until(message)
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 60
  until yield
    raise message if Process.clock_gettime(Process::CLOCK_MONOTONIC) > deadline

    sleep 1
  end
end

def check_photos(container)
  source = <<~RUBY
    require "tempfile"
    Tempfile.create(["photo", ".png"]) do |file|
      Vips::Image.black(30, 60).new_from_image([100, 90, 80]).write_to_file(file.path)
      user = User.find_by(email: "legacy@example.test")
      photo = ProfilePhoto.add(user, Struct.new(:tempfile).new(file))
      square = Vips::Image.new_from_buffer(photo.bytes(thumbnail: true), "")
      raise "Photo processing failed" unless [square.width, square.height] == [400, 400]
      photo.remove(user)
    end
  RUBY
  docker!('exec', container, 'bundle', 'exec', 'rails', 'runner', source)
end

def check_venue_photos(container)
  source = <<~RUBY
    require "tempfile"
    Tempfile.create(["photo", ".png"]) do |file|
      Vips::Image.black(30, 60).new_from_image([100, 90, 80]).write_to_file(file.path)
      photo = VenuePhoto.add(Venue.find("legacy-package-venue"), Struct.new(:tempfile).new(file))
      square = Vips::Image.new_from_buffer(photo.bytes(thumbnail: true), "")
      raise "Venue photo processing failed" unless [square.width, square.height] == [400, 400]
      photo.destroy!
    end
  RUBY
  docker!('exec', container, 'bundle', 'exec', 'rails', 'runner', source)
end

def check_monitoring(container)
  source = <<~RUBY
    config = NewRelic::Agent.config
    raise "Monitoring requires a license" if config[:agent_enabled]
    %i[attributes.enabled mongo.capture_queries application_logging.enabled
       browser_monitoring.auto_instrument].each do |setting|
      raise "Unsafe monitoring setting: \#{setting}" if config[setting]
    end
    raise "Exception messages are not private" unless config[:'strip_exception_messages.enabled']
  RUBY
  docker!('exec', container, 'bundle', 'exec', 'rails', 'runner', source)
end

options = {}
OptionParser.new do |parser|
  parser.on('--image IMAGE', 'Test an existing local image') { |value| options[:image] = value }
end.parse!
raise ArgumentError, 'Unexpected arguments' unless ARGV.empty?

suffix = SecureRandom.hex(6)
image = options[:image] || "posebook-package:#{suffix}"
unless image.match?(%r{\A[a-z0-9][a-z0-9._/-]*(?::[A-Za-z0-9._-]+)?\z})
  raise ArgumentError, 'Provide a local image name or tag'
end

network = nil
database = nil
container = nil

begin
  if options[:image]
    docker!('image', 'inspect', image)
    puts "Testing the existing image #{image}..."
  else
    puts 'Building the production image...'
    puts docker!('build', '--tag', image, '.')
  end
  network = docker!('network', 'create', "posebook-package-#{suffix}")
  database = docker!(
    'run', '--detach', '--network', network, '--network-alias', 'mongodb',
    '--health-cmd', 'mongosh --quiet --eval "db.adminCommand({ping: 1})"',
    '--health-interval', '2s', '--health-timeout', '5s', '--health-retries', '20', 'mongo:8.0',
    '--replSet', 'rs0', '--bind_ip_all'
  )
  wait_until('MongoDB did not become healthy') do
    docker!('inspect', '--format', '{{.State.Health.Status}}', database) == 'healthy'
  end
  docker!('exec', database, 'mongosh', '--quiet', '--eval',
          'rs.initiate({_id:"rs0",members:[{_id:0,host:"mongodb:27017"}]})')
  wait_until('MongoDB replica set did not elect a primary') do
    docker!('exec', database, 'mongosh', '--quiet', '--eval', 'db.hello().isWritablePrimary') == 'true'
  end
  docker!('exec', database, 'mongosh', '--quiet', '--eval',
          'let target=db.getSiblingDB("posebook_package"); ' \
          'target.venues.insertOne({name:"Legacy Package Venue",address:"Test"}); ' \
          'let venue={_id:ObjectId(),name:"Current Package Venue",address:"Test",session_schema_version:1}; ' \
          'target.venues.insertOne(venue); ' \
          'target.drawing_sessions.insertOne({name:"Existing Package Session",venue_id:venue._id,' \
          'model_pay:150,available_weekdays:["1"],start_time:"19:00",time_zone:"America/New_York",' \
          'booking_horizon_months:6,instructions:"Preserved instructions",schedule_revision:3})')
  container = docker!(
    'run', '--detach', '--publish', '127.0.0.1::3000', '--network', network,
    '--env', "SECRET_KEY_BASE=#{SecureRandom.hex(64)}",
    '--env', 'MONGODB_URI=mongodb://mongodb:27017/posebook_package',
    image
  )
  port = docker!('port', container, '3000/tcp').split(':').last.to_i

  wait_until('The packaged application did not become healthy') do
    request(port, '/up').code == '200'
  rescue SystemCallError, Timeout::Error, EOFError
    false
  end

  raise 'The blank installation did not redirect to registration' unless request(port, '/').code == '302'

  response = request(port, '/registration/new')
  unless response.code == '200' && response.body.include?('Create Your Account')
    raise 'First-user registration did not render'
  end

  stylesheets = response.body.scan(/href="([^"]+\.css)"/).flatten
  theme = stylesheets.find { |path| path.include?('/caramellatte-') }
  unless theme && request(port, theme).body.include?('--color-base-100') &&
         stylesheets.all? { |path| request(port, path).code == '200' } &&
         response.body.include?('data-theme="caramellatte"')
    raise 'The packaged theme and stylesheets are missing'
  end

  logo = response.body[/src="([^"]*posebook-logo[^"]+\.png)"/, 1]
  favicon = response.body[/href="([^"]*posebook-favicon[^"]+\.png)"/, 1]
  raise 'The packaged logo and favicon are missing' unless logo && favicon

  [logo, favicon].each do |asset|
    image_response = request(port, asset)
    unless image_response.code == '200' && image_response['Content-Type'].start_with?('image/png') &&
           image_response.body.b.start_with?("\x89PNG\r\n\x1a\n".b)
      raise 'The packaged logo or favicon is unavailable'
    end
  end

  docker!('exec', database, 'mongosh', '--quiet', '--eval',
          'db.getSiblingDB("posebook_package").users.insertOne({name:"Legacy Model",email:"legacy@example.test",' \
          'instagram_url:"https://www.instagram.com/Legacy.Model/",instagram_tagging_allowed:true,' \
          'public_profile_private:true})')
  docker!('exec', container, './bin/docker-entrypoint', 'bundle', 'exec', 'rails', 'runner',
          'user = User.find_by(email: "legacy@example.test"); ' \
          'raise "Handle migration failed" unless user.instagram_handle == "legacy.model" && ' \
          '!user.attributes.key?("instagram_url") && user.instagram_tagging_allowed? && user.public_profile_private?')
  docker!(
    'exec', container, 'bundle', 'exec', 'rails', 'runner',
    'location = Venue.find("legacy-package-venue"); program = Program.find("legacy-package-venue"); ' \
    'raise "Venue/session migration failed" unless program.venue_id == location.id && ' \
    'program.name == "Legacy Package Venue"; ' \
    'Program.transaction { Program.create!(name: "Package Transaction", venue: location); ' \
    'raise Mongoid::Errors::Rollback }; ' \
    'raise "Rollback failed" if Program.where(name: "Package Transaction").exists?; ' \
    'existing = Program.find_by(name: "Existing Package Session"); ' \
    'raise "Program schema conversion failed" unless existing.venue.name == "Current Package Venue" && ' \
    'existing.pay == 150 && existing.program_label == "Session" && existing.participant_label == "Model" && ' \
    'existing.schedule_revision == 3 && existing.instructions == "Preserved instructions" && ' \
    '!existing.attributes.key?("model_pay") && ' \
    '!Mongoid.default_client.database.collection_names.include?("drawing_sessions")'
  )
  check_photos(container)
  check_venue_photos(container)
  check_monitoring(container)
  puts 'Production image passed monitoring configuration, photo processing/storage/deletion, ' \
       'handle migration, slug setup, rollback, ' \
       'indexes, registration, ' \
       'stylesheet, logo/favicon, and liveness checks.'
ensure
  if container
    puts docker!('logs', container)
    docker!('rm', '--force', container)
  end
  docker!('rm', '--force', database) if database
  docker!('network', 'rm', network) if network
  if !options[:image] && system('docker', 'image', 'inspect', image, out: File::NULL, err: File::NULL)
    docker!('image', 'rm', image)
  end
end
